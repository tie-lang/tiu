type tie<logic>
// layout_golden.tie —— 布局求解器的几何黄金表探针
// EN: golden-rectangle probe for ui/src/layout2.tie — exact x/y/w/h assertions.
// ============================================================
// 规约：每个用例自建一棵小树 → tiu_layout2.layout(root, win_w, win_h) →
//   断言精确整数像素矩形；打印「用例名 期望=… 实得=… OK/FAIL」；
//   末尾汇总，有 FAIL 时退出码非零。
// 期望值全部由设计稿（_local_only/design/layout-syntax.md §3/§4/§5/§7）手算：
//   1 单位 = 1/64 像素；fr 用最大余数法；clamp 让出的空间不回灌主轴。
// ============================================================

import "../ui/src/tree.tie"
import "../ui/src/props.tie"
import "../ui/src/layout2.tie"

var g_ok: i64 = 0
var g_fail: i64 = 0
var g_stack: table<i64> = []
var g_top: i64 = 0
var g_slot: i64 = 0

// ---- 建树（显式栈；slot 全局递增）----
func begin() {
    tiu_tree.reset()
    tiu_props.reset()
    g_stack = table_new_i64()
    g_top = 0
    g_slot = 0
}

func open(ty: WidgetType) -> i64 {
    var parent: i64 = -1
    if g_top > 0 {
        parent = g_stack[g_top - 1]
    }
    var id = tiu_tree.mount(parent, g_slot, ty)
    g_slot = g_slot + 1
    while len(g_stack) <= g_top {
        table_push(g_stack, 0)
    }
    g_stack[g_top] = id
    g_top = g_top + 1
    return id
}

func close() {
    if g_top > 0 {
        g_top = g_top - 1
    }
}

// 文本叶子（默认 hug × hug）
func text_node(s: string) -> i64 {
    var id = open(WidgetType.Text)
    tiu_tree.set_text(id, s)
    close()
    return id
}

// ---- 属性糖（系数一律 ×100：px 用百分之一像素，pct 用百分之一百分点）----
func pxw(id: i64, v: i64) { tiu_props.set_w(id, 2, v * 100, 0) }
func pxh(id: i64, v: i64) { tiu_props.set_h(id, 2, v * 100, 0) }
func fillw(id: i64) { tiu_props.set_w(id, 1, 0, 0) }
func fillh(id: i64) { tiu_props.set_h(id, 1, 0, 0) }
func frw(id: i64, n: i64) { tiu_props.set_w(id, 4, n * 100, 0) }
func pctw(id: i64, n: i64) { tiu_props.set_w(id, 3, n * 100, 0) }
func pcth(id: i64, n: i64) { tiu_props.set_h(id, 3, n * 100, 0) }
func minw(id: i64, v: i64) { tiu_props.set_min_w(id, 2, v * 100) }
func maxw(id: i64, v: i64) { tiu_props.set_max_w(id, 2, v * 100) }

// ---- 断言 ----
func expect(name: string, id: i64, ex: i64, ey: i64, ew: i64, eh: i64) {
    var r = tiu_tree.rect(id)
    var want = "x=" + to_string(ex) + " y=" + to_string(ey) + " w=" + to_string(ew) + " h=" + to_string(eh)
    var got = "x=" + to_string(r.x) + " y=" + to_string(r.y) + " w=" + to_string(r.w) + " h=" + to_string(r.h)
    if r.x == ex && r.y == ey && r.w == ew && r.h == eh {
        g_ok = g_ok + 1
        println(name + " 期望=" + want + " 实得=" + got + " OK")
    } else {
        g_fail = g_fail + 1
        println(name + " 期望=" + want + " 实得=" + got + " FAIL")
    }
}

func expect_i(name: string, got: i64, want: i64) {
    if got == want {
        g_ok = g_ok + 1
        println(name + " 期望=" + to_string(want) + " 实得=" + to_string(got) + " OK")
    } else {
        g_fail = g_fail + 1
        println(name + " 期望=" + to_string(want) + " 实得=" + to_string(got) + " FAIL")
    }
}

// ============================================================
// 用例 1：hug 文本宽度 —— Text "Hello" @16px ⇒ 5 × 9.6 = 48
// ============================================================
func case_hug_text() {
    begin()
    var root = open(WidgetType.Column)
    pxw(root, 200)
    pxh(root, 100)
    var t = text_node("Hello")
    tiu_layout2.layout(root, 200, 100)
    expect("01_hug_text", t, 0, 0, 48, 16)
    expect("01_hug_text_root", root, 0, 0, 200, 100)
}

// ============================================================
// 用例 2：fill 平分 —— 300 宽两子项 ⇒ 150 / 150
// ============================================================
func case_fill_split() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 300)
    pxh(root, 100)
    var a = open(WidgetType.Column)
    fillw(a)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    fillw(b)
    fillh(b)
    close()
    tiu_layout2.layout(root, 300, 100)
    expect("02_fill_split_a", a, 0, 0, 150, 100)
    expect("02_fill_split_b", b, 150, 0, 150, 100)
}

// ============================================================
// 用例 3：2fr + 1fr 最大余数 —— 100 宽按 2:1 ⇒ 66.67/33.33
//   定点：share0=4266 余 rem0=200 > rem1=100 ⇒ +1 ⇒ 4267(67px) / 2133(33px)
// ============================================================
func case_fr_remainder() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 100)
    pxh(root, 100)
    var a = open(WidgetType.Column)
    frw(a, 2)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    frw(b, 1)
    fillh(b)
    close()
    tiu_layout2.layout(root, 100, 100)
    expect("03_fr_2_1_a", a, 0, 0, 67, 100)
    expect("03_fr_2_1_b", b, 67, 0, 33, 100)
}

// ============================================================
// 用例 4：% 在定尺寸父上 —— 父 400×300，子 60% × 50% ⇒ 240 × 150
// ============================================================
func case_pct_fixed() {
    begin()
    var root = open(WidgetType.Column)
    pxw(root, 400)
    pxh(root, 300)
    var a = open(WidgetType.Row)
    pctw(a, 60)
    pcth(a, 50)
    close()
    tiu_layout2.layout(root, 400, 300)
    expect("04_pct_on_fixed", a, 0, 0, 240, 150)
}

// ============================================================
// 用例 5：padding + gap 扣减 —— 320 宽、pad l/r=20、gap=8 ⇒ 内容 280
//   ⇒ 每子 (280-8)/2 = 136；x = 20 / 164；y = pad_t = 10；高 = 100-20 = 80
// ============================================================
func case_pad_gap() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 320)
    pxh(root, 100)
    tiu_props.set_pad(root, 10, 20, 10, 20)
    tiu_props.set_gap(root, 8)
    var a = open(WidgetType.Column)
    fillw(a)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    fillw(b)
    fillh(b)
    close()
    tiu_layout2.layout(root, 320, 100)
    expect("05_pad_gap_a", a, 20, 10, 136, 80)
    expect("05_pad_gap_b", b, 164, 10, 136, 80)
}

// ============================================================
// 用例 6：min/max 夹取 —— 400 宽两 fill（各 200）
//   A max-w 120 ⇒ 120；B min-w 250 ⇒ 250；让出的 30 不回灌（I1）
// ============================================================
func case_clamp() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 400)
    pxh(root, 100)
    var a = open(WidgetType.Column)
    fillw(a)
    fillh(a)
    maxw(a, 120)
    close()
    var b = open(WidgetType.Column)
    fillw(b)
    fillh(b)
    minw(b, 250)
    close()
    tiu_layout2.layout(root, 400, 100)
    expect("06_clamp_max_a", a, 0, 0, 120, 100)
    expect("06_clamp_min_b", b, 120, 0, 250, 100)
}

// ============================================================
// 用例 7：交叉轴 center —— 行高 100、子高 40 ⇒ y = (100-40)/2 = 30
// ============================================================
func case_cross_center() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 300)
    pxh(root, 100)
    tiu_props.set_dist_y(root, 1)
    var a = open(WidgetType.Column)
    pxw(a, 100)
    pxh(a, 40)
    close()
    var b = open(WidgetType.Column)
    pxw(b, 100)
    pxh(b, 40)
    close()
    tiu_layout2.layout(root, 300, 100)
    expect("07_cross_center_a", a, 0, 30, 100, 40)
    expect("07_cross_center_b", b, 100, 30, 100, 40)
}

// ============================================================
// 用例 8：交叉轴 stretch —— 子项 h=hug（空容器 0）⇒ 撑满 100
// ============================================================
func case_cross_stretch() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 300)
    pxh(root, 100)
    tiu_props.set_dist_y(root, 6)
    var a = open(WidgetType.Column)
    pxw(a, 100)
    close()
    var b = open(WidgetType.Column)
    pxw(b, 100)
    close()
    tiu_layout2.layout(root, 300, 100)
    expect("08_cross_stretch_a", a, 0, 0, 100, 100)
    expect("08_cross_stretch_b", b, 100, 0, 100, 100)
}

// ============================================================
// 用例 9：x: space-between —— 300 宽、三子各 50 ⇒ 余 150 分两份 75
//   ⇒ x = 0 / 125 / 250
// ============================================================
func case_space_between() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 300)
    pxh(root, 100)
    tiu_props.set_dist_x(root, 3)
    var a = open(WidgetType.Column)
    pxw(a, 50)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    pxw(b, 50)
    fillh(b)
    close()
    var c = open(WidgetType.Column)
    pxw(c, 50)
    fillh(c)
    close()
    tiu_layout2.layout(root, 300, 100)
    expect("09_space_between_a", a, 0, 0, 50, 100)
    expect("09_space_between_b", b, 125, 0, 50, 100)
    expect("09_space_between_c", c, 250, 0, 50, 100)
}

// ============================================================
// 用例 10：grid 三列混合 —— 300 宽，cols = [px 100, 1fr, 1fr]，gap 0
//   列宽 100/100/100；两行各高 30（hug 取行内最高 30）⇒ y = 0 / 30
// ============================================================
func case_grid() {
    begin()
    var root = open(WidgetType.Grid)
    pxw(root, 300)
    pxh(root, 200)
    tiu_props.add_col(root, 2, 10000, 0)
    tiu_props.add_col(root, 4, 100, 0)
    tiu_props.add_col(root, 4, 100, 0)
    var a = open(WidgetType.Column)
    fillw(a)
    pxh(a, 30)
    close()
    var b = open(WidgetType.Column)
    fillw(b)
    pxh(b, 30)
    close()
    var c = open(WidgetType.Column)
    fillw(c)
    pxh(c, 30)
    close()
    var d = open(WidgetType.Column)
    fillw(d)
    pxh(d, 30)
    close()
    tiu_layout2.layout(root, 300, 200)
    expect("10_grid_a", a, 0, 0, 100, 30)
    expect("10_grid_b", b, 100, 0, 100, 30)
    expect("10_grid_c", c, 200, 0, 100, 30)
    expect("10_grid_d", d, 0, 30, 100, 30)
}

// ============================================================
// 用例 11：overlay 四角锚点 —— 300×200 内 50×30 的子项
//   anchor 0 top-start / 2 top-end / 6 bottom-start / 8 bottom-end
// ============================================================
func case_overlay() {
    begin()
    var root = open(WidgetType.Overlay)
    pxw(root, 300)
    pxh(root, 200)
    var tl = open(WidgetType.Column)
    pxw(tl, 50)
    pxh(tl, 30)
    tiu_props.set_anchor(tl, 0)
    close()
    var tr = open(WidgetType.Column)
    pxw(tr, 50)
    pxh(tr, 30)
    tiu_props.set_anchor(tr, 2)
    close()
    var bl = open(WidgetType.Column)
    pxw(bl, 50)
    pxh(bl, 30)
    tiu_props.set_anchor(bl, 6)
    close()
    var br = open(WidgetType.Column)
    pxw(br, 50)
    pxh(br, 30)
    tiu_props.set_anchor(br, 8)
    close()
    tiu_layout2.layout(root, 300, 200)
    expect("11_overlay_tl", tl, 0, 0, 50, 30)
    expect("11_overlay_tr", tr, 250, 0, 50, 30)
    expect("11_overlay_bl", bl, 0, 170, 50, 30)
    expect("11_overlay_br", br, 250, 170, 50, 30)
}

// ============================================================
// 用例 12：overflow: clip 不改变几何 —— 100 宽容器装 2×80
//   几何照旧（第二子 x=80），只是记裁剪位；不产生诊断
// ============================================================
func case_overflow_clip() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 100)
    pxh(root, 50)
    tiu_props.set_overflow(root, 0)
    var a = open(WidgetType.Column)
    pxw(a, 80)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    pxw(b, 80)
    fillh(b)
    close()
    tiu_layout2.layout(root, 100, 50)
    expect("12_clip_a", a, 0, 0, 80, 50)
    expect("12_clip_b", b, 80, 0, 80, 50)
    expect_i("12_clip_diag_count", tiu_layout2.diag_count(), 0)
    expect_i("12_clip_ov_root", tiu_layout2.ov_flags(root), 1)
}

// ============================================================
// 用例 13：overflow: error 产生一条诊断 —— 同上但策略=error
// ============================================================
func case_overflow_error() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 100)
    pxh(root, 50)
    tiu_props.set_overflow(root, 3)
    var a = open(WidgetType.Column)
    pxw(a, 80)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    pxw(b, 80)
    fillh(b)
    close()
    tiu_layout2.layout(root, 100, 50)
    expect("13_error_a", a, 0, 0, 80, 50)
    expect("13_error_b", b, 80, 0, 80, 50)
    expect_i("13_error_diag_count", tiu_layout2.diag_count(), 1)
    if tiu_layout2.diag_count() > 0 {
        println("  diag[0] = " + tiu_layout2.diag_at(0))
    }
}

// ============================================================
// 用例 14：overflow: expand —— 溢出轴改回 hug（牺牲父给尺寸）
//   100 宽内容需 160 ⇒ 根宽 160，子项照常落位，不产生诊断
// ============================================================
func case_overflow_expand() {
    begin()
    var root = open(WidgetType.Row)
    pxw(root, 100)
    pxh(root, 50)
    tiu_props.set_overflow(root, 2)
    var a = open(WidgetType.Column)
    pxw(a, 80)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    pxw(b, 80)
    fillh(b)
    close()
    tiu_layout2.layout(root, 100, 50)
    expect("14_expand_root", root, 0, 0, 160, 50)
    expect("14_expand_a", a, 0, 0, 80, 50)
    expect("14_expand_b", b, 80, 0, 80, 50)
    expect_i("14_expand_diag_count", tiu_layout2.diag_count(), 0)
}

// ============================================================
// explain() 真实输出（不参与断言，供报告引用）
// ============================================================
func demo_explain() {
    begin()
    var root = open(WidgetType.Column)
    pxw(root, 320)
    pxh(root, 240)
    tiu_props.set_pad(root, 12, 12, 12, 12)
    tiu_props.set_gap(root, 6)
    var row = open(WidgetType.Row)
    pctw(row, 60)
    fillh(row)
    tiu_props.set_dist_x(row, 3)
    tiu_props.set_min_h(row, 2, 4000)
    var a = open(WidgetType.Column)
    frw(a, 1)
    fillh(a)
    close()
    var b = open(WidgetType.Column)
    frw(b, 2)
    fillh(b)
    close()
    close()
    tiu_layout2.layout(root, 320, 240)
    println("--- explain(sample/row) ---")
    println(tiu_layout2.explain(row))
    println("--- explain(sample/child-b) ---")
    println(tiu_layout2.explain(b))
}

// ============================================================
func main() -> i32 {
    println("=== layout_golden: 几何黄金表（26.6 定点 → 整数像素）===")
    case_hug_text()
    case_fill_split()
    case_fr_remainder()
    case_pct_fixed()
    case_pad_gap()
    case_clamp()
    case_cross_center()
    case_cross_stretch()
    case_space_between()
    case_grid()
    case_overlay()
    case_overflow_clip()
    case_overflow_error()
    case_overflow_expand()
    demo_explain()
    println("=== 汇总: 通过=" + to_string(g_ok) + " 失败=" + to_string(g_fail) + " ===")
    if g_fail > 0 {
        return 1
    }
    return 0
}
