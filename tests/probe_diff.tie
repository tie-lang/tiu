type tie<logic>
// probe_diff: 差分桥探针（静态帧零段 / 单叶段 / 兄弟隔离 / 替换 / 卸载 / 上卷）
import "../ui/src/build.tie"
import "../ui/src/layout.tie"
import "../ui/src/diff.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func child_at(root: i64, n: i64) -> i64 {
    var c = tiu_tree.first_child(root)
    var k: i64 = 0
    while k < n {
        c = tiu_tree.next_sibling(c)
        k = k + 1
    }
    return c
}

// 建树：Column(0) > [Text(slot0,"AB"), Row(slot1) > [Text(slot0,"x"), Text(slot1,"y")]]
func build_tree() {
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 1, 2, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Row, 1, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 1, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Text, 1, 1, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
}

func main() {
    // ---------- 帧 1：构建 + 布局 + 快照 ----------
    tiu_tree.reset()
    build_tree()
    var root = tiu_tree.root()
    var c1 = Constraints.loose()
    tiu_layout.layout(root, c1)
    tiu_diff.begin_frame()
    check(tiu_diff.delta_count() == 0, "frame1 baseline")

    // ---------- 静态帧：同内容 → 零段零编码 ----------
    build_tree()
    tiu_layout.layout(root, c1)
    var n1 = tiu_diff.diff()
    check(n1 == 0, "static frame: 0 delta segments")
    tiu_diff.begin_frame()

    // ---------- 单叶变化：Text("AB") ver 1→2 ----------
    var ta = child_at(root, 0)
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 3, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Row, 1, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 1, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Text, 1, 1, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
    tiu_layout.layout(root, c1)
    var n2 = tiu_diff.diff()
    check(n2 == 1, "leaf change: exactly 1 segment")
    check(tiu_diff.delta_key(0) == "0:0", "leaf change: key prefix 0:0")
    check(tiu_diff.delta_node(0) == ta, "leaf change: node id matches")
    var d0 = tiu_diff.delta_rect(0)
    check(d0.x == 0 && d0.y == 0 && d0.w == 24 && d0.h == 32,
        "leaf change: dirty rect rolled up to root (0,0,24,32)")
    tiu_diff.begin_frame()

    // ---------- 兄弟隔离：Row 内 Text("x") ver 1→2 → 段 key 0:1:0 ----------
    var row = child_at(root, 1)
    var tx = child_at(row, 0)
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 3, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Row, 1, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Text, 1, 1, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
    tiu_layout.layout(root, c1)
    var n3 = tiu_diff.diff()
    check(n3 == 1, "sibling isolation: 1 segment")
    check(tiu_diff.delta_key(0) == "0:1:0", "sibling isolation: key 0:1:0")
    check(tiu_diff.delta_node(0) == tx, "sibling isolation: node = row text0")
    tiu_diff.begin_frame()

    // ---------- 父变化：Column ver 1→2 → 1 段（key 0）----------
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 2, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 3, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Row, 1, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Text, 1, 1, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
    tiu_layout.layout(root, c1)
    var n4 = tiu_diff.diff()
    check(n4 == 1, "parent change: 1 segment (subtree covered)")
    check(tiu_diff.delta_key(0) == "0", "parent change: key 0")
    tiu_diff.begin_frame()

    // ---------- 新建：Column 加 slot2 Text ----------
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 2, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 3, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Row, 1, 1, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Text, 1, 1, 1, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.open(WidgetType.Text, 2, 1, 4, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
    tiu_layout.layout(root, c1)
    var n5 = tiu_diff.diff()
    check(n5 == 1, "new slot: 1 segment")
    check(tiu_diff.delta_key(0) == "0:2", "new slot: key 0:2")
    tiu_diff.begin_frame()

    // ---------- 替换：Row(slot1) → Button（同 slot 异 type）→ 1 段 ----------
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 2, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 3, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Button, 1, 3, 2, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Text, 2, 1, 4, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
    tiu_layout.layout(root, c1)
    var n6 = tiu_diff.diff()
    check(n6 == 1, "type swap: 1 segment (subtree rebuilt under one prefix)")
    check(tiu_diff.delta_key(0) == "0:1", "type swap: key 0:1")
    // 新 Button 挂到兄弟链尾（slot 定位查找）
    var btn = tiu_tree.first_child(root)
    while tiu_tree.slot_of(btn) != 1 {
        btn = tiu_tree.next_sibling(btn)
    }
    check(tiu_diff.delta_node(0) == btn, "type swap: node = new button")
    tiu_diff.begin_frame()

    // ---------- 卸载：删除 slot2 Text ----------
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 2, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 3, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Button, 1, 3, 2, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
    tiu_layout.layout(root, c1)
    var n7 = tiu_diff.diff()
    check(n7 == 1, "unmount: 1 segment")
    check(tiu_diff.delta_key(0) == "0:2", "unmount: key 0:2")
    check(tiu_diff.delta_node(0) == -1, "unmount: node = -1")
    tiu_diff.begin_frame()

    // ---------- 静态帧收尾 ----------
    tiu_build.begin()
    tiu_build.open(WidgetType.Column, 0, 2, 0, 0, 0, 0, 0)
    tiu_build.open(WidgetType.Text, 0, 2, 3, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.open(WidgetType.Button, 1, 3, 2, 0, 0, 0, 0)
    tiu_build.close()
    tiu_build.close()
    tiu_build.finish()
    tiu_layout.layout(root, c1)
    var n8 = tiu_diff.diff()
    check(n8 == 0, "final static frame: 0 segments")

    if fails > 0 {
        println("PROBE_DIFF FAIL " + to_string(fails))
        exit(1)
    } else {
        println("PROBE_DIFF PASS")
    }
}
