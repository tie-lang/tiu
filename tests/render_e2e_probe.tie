type tie<logic>
// tests/render_e2e_probe.tie —— 端到端验收：元素语法 → 布局求解 → 绘制 → 像素
// ============================================================
// 与 paint_probe 的分工：paint_probe 直接摆矩形（只验绘制层），本探针不摆任何
// 矩形——视图用元素语法写，几何全部来自 layout2 求解，再走真实的「绘制记录 →
// IR 字节 → loader 解析 → 软件光栅」链路，最后在帧缓冲上断言像素。
// 因此它同时约束四个层：元素降解（pstmt_ui/std/ui）、属性类型化（props/
// attr_parse）、几何（layout2）、绘制（paint/paint_bridge/raster）。
//
// 编译（tie 仓根下）：
//   TIE_LIB_ROOT=<tie 仓根> ./_local_only/bin/tiec.exe ../tiu/tests/render_e2e_probe.tie \
//     -l2 -t0 --no-warn --no-cache -o ../tiu/_local_only/bin/render_e2e_probe.exe
// EN: end-to-end probe — element syntax to solved geometry to painted pixels.

import "../ui/src/tree.tie"
import "../ui/src/props.tie"
import "../ui/src/theme.tie"
import "../ui/src/layout2.tie"
import "../ui/src/paint_state.tie"
import "../ui/src/paint_bridge.tie"
import "../ui/src/event.tie"
import "../ui/src/ui_bridge.tie"
import "../ui/src/attr_parse.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/drawlist.tie"
import "../api/src/canvas.tie"
import "../engine/src/semantics.tie"
import "../engine/src/font.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/eimg.tie"

const W: i64 = 260
const H: i64 = 200
const DPI: f64 = 1.0
const TH: i64 = 0
const FONT_CONSULA: string = "C:/Windows/Fonts/consola.ttf"

var g_fail: i64 = 0
var g_pass: i64 = 0
var g_clicks: i64 = 0

func ck(name: string, ok: bool, detail: string) {
    if ok {
        g_pass = g_pass + 1
        println("OK   " + name + " | " + detail)
    } else {
        g_fail = g_fail + 1
        println("FAIL " + name + " | " + detail)
    }
}

func px_at(fb: FrameBuf, x: i64, y: i64) -> i64 {
    if x < 0 || y < 0 || x >= fb.w || y >= fb.h {
        return 0
    }
    return fb.px[y * fb.w + x]
}

func col_text(c: i64) -> string {
    return "argb=" + to_string(c) + " r=" + to_string(sem.ch_r(c)) + " g=" + to_string(sem.ch_g(c)) + " b=" + to_string(sem.ch_b(c))
}

// ------------------------------------------------------------------
// 待验视图：全部用元素语法写，不出现一个手摆矩形
// ------------------------------------------------------------------

// 事件轴 → std/ui 函数值派发：事件轴的 sink 协议是 (目标节点, 事件名, x, y, 阶段)。
pub func sink(node: i64, name: string, x: i64, y: i64, kind: string) -> i64 {
    return ui_bridge.dispatch(node, name, x, y, kind)
}

// 事件处理器签名由 std/ui 约定：fn(节点 id, x, y, 事件种类) -> i64
func bump(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_clicks = g_clicks + 1
    return 0
}

func view() {
    ui.reset()
    @ window "端到端" (size: 260 x 200) {
        @ column "root" (w: fill, h: fill, pad: 12, gap: 10) {
            @ label "标题" (font_size: 20)
            @ button "计数" (w: fill, h: 40, text: "+1", on_click: bump)
        }
    }
}

// ------------------------------------------------------------------
// 整帧渲染：布局产物 → 绘制记录 → IR → 光栅
// ------------------------------------------------------------------

func shot(th: i64) -> FrameBuf {
    var cv = cvs.new_offscreen(W, H, DPI)
    var d = cvs.record(cv)
    d = upaint.background(d, W, H, th)
    d = upaint.draw_state(d, th, -1, -1, -1)
    var ir = cvs.submit(cv, d)
    var p = eload.parse_frame(ir)
    return erast.render(p)
}

// 盒内「非背景」像素计数（墨迹与面板都算），用于证明内容真的画出来了。
func ink_in(fb: FrameBuf, x0: i64, y0: i64, x1: i64, y1: i64, bg: i64) -> i64 {
    var n = 0
    var y = y0
    while y < y1 {
        var x = x0
        while x < x1 {
            if px_at(fb, x, y) != bg {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// ------------------------------------------------------------------
// 主流程
// ------------------------------------------------------------------

func main() -> i32 {
    erast.text_font(FONT_CONSULA)
    var face = erast.text_face_id()
    upaint.set_text_face(face)
    tiu_layout2.set_face(face)

    view()

    // 1) 元素语法确实产出了节点，且名字/种类可查
    var n_title = ui.find("标题")
    var n_btn = ui.find("计数")
    ck("元素语法产出节点", ui.count() >= 3, "count=" + to_string(ui.count()))
    ck("节点可按名字查找", n_title >= 0 && n_btn >= 0, "标题=" + to_string(n_title) + " 计数=" + to_string(n_btn))
    ck("节点种类正确", ui.kind_at(n_title) == "label" && ui.kind_at(n_btn) == "button",
        "标题=" + ui.kind_at(n_title) + " 计数=" + ui.kind_at(n_btn))

    // 2) 桥接 + 求解：几何来自 layout2，不是手摆的
    var root = ui_bridge.build_at(W, H)
    ck("桥接建树成功", root >= 0, "root=" + to_string(root))
    ck("树规模与 ui 节点数一致", tiu_tree.count() >= ui.count(),
        "tree=" + to_string(tiu_tree.count()) + " ui=" + to_string(ui.count()))

    // 3) 像素：背景、按钮底色、标题墨迹
    var fb = shot(TH)
    var bg = uth.bg(TH)
    ck("帧尺寸", fb.w == W && fb.h == H, "w=" + to_string(fb.w) + " h=" + to_string(fb.h))
    // 根容器铺满视口 ⇒ 左上角是容器面板而非裸背景：面板真的画出来了才算对。
    // 根容器有自己的圆角面板：内部像素是面板色，四角是圆角抗锯齿的混合色
    // （既非纯背景也非纯面板）——同时证明「面板真的画了」与「圆角真的生效」。
    var want_surf = uth.surface(TH)
    ck("根容器面板铺满视口内部", px_at(fb, 130, 5) == want_surf,
        "(130,5) 期望[" + col_text(want_surf) + "] 实得[" + col_text(px_at(fb, 130, 5)) + "]")
    var corner = px_at(fb, 1, 1)
    ck("圆角外侧是抗锯齿混合色", corner != bg && corner != want_surf,
        "(1,1) 背景[" + col_text(bg) + "] 面板[" + col_text(want_surf) + "] 实得[" + col_text(corner) + "]")

    // 按钮中心：由元素语法给定 w=fill h=40，落在 pad=12 的内边距里，位置可推出；
    // 但本探针不硬编码矩形——用命中去问「这里是哪个控件」，再比对该控件应得的颜色。
    tiu_event.layout_changed()
    // 不猜矩形：沿中线扫一遍命中，找出「命中结果等于按钮节点」的那段 y 区间。
    var btn_node = ui_bridge.node_of_ui(n_btn)
    var cx = W / 2
    var y0 = 0 - 1
    var y1 = 0 - 1
    var yy = 0
    while yy < H {
        if tiu_event.hit(cx, yy) == btn_node {
            if y0 < 0 {
                y0 = yy
            }
            y1 = yy
        }
        yy = yy + 1
    }
    ck("按钮在布局里占据竖直区间", btn_node >= 0 && y0 >= 0 && y1 > y0,
        "node=" + to_string(btn_node) + " y=[" + to_string(y0) + "," + to_string(y1) + "]")
    var cy = (y0 + y1) / 2
    var hit = tiu_event.hit(cx, cy)
    ck("按钮区间内命中按钮", hit == btn_node, "hit=" + to_string(hit) + " 按钮节点=" + to_string(btn_node))
    var want_btn = uth.accent(TH)
    ck("按钮底色=主题 accent", px_at(fb, cx, cy) == want_btn,
        "(" + to_string(cx) + "," + to_string(cy) + ") 期望[" + col_text(want_btn) + "] 实得[" + col_text(px_at(fb, cx, cy)) + "]")

    // 标题墨迹：从命中扫描推出标题的 y 区间，避免硬编码矩形。
    var title_node = ui_bridge.node_of_ui(n_title)
    var ty0 = 0 - 1
    var ty1 = 0 - 1
    yy = 0
    while yy < H {
        if tiu_event.hit(12, yy) == title_node || tiu_event.hit(W / 2, yy) == title_node {
            if ty0 < 0 {
                ty0 = yy
            }
            ty1 = yy
        }
        yy = yy + 1
    }
    var header_ink = ink_in(fb, 12, ty0, 240, ty1 + 1, want_surf)
    ck("标题真的画出墨迹", header_ink > 40, "墨迹像素=" + to_string(header_ink))

    // 4) 事件：元素里的 on_click 绑定经桥接派发到处理器
    var hd = tiu_event.mouse_move(cx, cy, sink)
    ck("hover 命中按钮", tiu_event.hover() == btn_node, "hover=" + to_string(tiu_event.hover()) + " 按钮节点=" + to_string(btn_node))
    var dn = tiu_event.mouse_down(cx, cy, 0, sink)
    var up = tiu_event.mouse_up(cx, cy, 0, sink)
    ck("点击派发到 on_click 处理器", g_clicks == 1, "clicks=" + to_string(g_clicks) + " down=" + to_string(dn) + " up=" + to_string(up))

    // 5) 同一次点击之后重画：按钮进入 active 观感（绘制状态真的被事件驱动）
    var fb2 = shot(TH)
    var changed = 0
    var y = 0
    while y < H {
        var x = 0
        while x < W {
            if px_at(fb, x, y) != px_at(fb2, x, y) {
                changed = changed + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    ck("事件后重画帧与事件前不同", changed > 0, "差异像素=" + to_string(changed))

    println("summary PASS=" + to_string(g_pass) + " FAIL=" + to_string(g_fail))
    if g_fail == 0 {
        println("render e2e ok")
        return 0
    }
    return 1
}
