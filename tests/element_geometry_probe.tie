type tie<logic, unsafe:mem>
// element_geometry_probe.tie —— 元素语法 → std/ui → 桥接 → 布局 的几何一致性探针。
// 判据：元素上写的尺寸/内边距/间距必须真的变成布局矩形；子元素顺序与间距正确。
import "../ui/src/tree.tie"
import "../ui/src/props.tie"
import "../ui/src/layout2.tie"
import "../ui/src/ui_bridge.tie"

var g_pass: i64 = 0
var g_fail: i64 = 0

func check(name: string, got: i64, want: i64) {
    if got == want {
        g_pass = g_pass + 1
        println("OK   " + name + " = " + to_string(got))
    } else {
        g_fail = g_fail + 1
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
    }
}

func main() -> i64 {
    @ app "probe" (w: fill, h: fill) {
        @ column "col" (pad: 12, gap: 8) {
            @ button "加" (w: 104, h: 36) { "0" }
            @ button "减" (w: 104, h: 36) { "0" }
        }
    }
    var n = ui.root_count()
    check("根元素数", n, 1)
    var root_ui = ui.root_at(0)
    var root = ui_bridge.build_at(320, 200)
    check("tiu 根节点", root, 0)
    var r = tiu_tree.rect(root)
    check("根 x", r.x, 0)
    check("根 y", r.y, 0)
    check("根 w", r.w, 320)
    check("根 h", r.h, 200)
    var col_ui = ui.child_at(root_ui, 0)
    var col = ui_bridge.node_of_ui(col_ui)
    var cr = tiu_tree.rect(col)
    check("列 x", cr.x, 0)
    check("列 y", cr.y, 0)
    check("列 w(hug)", cr.w, 128)
    check("列 h(hug)", cr.h, 104)
    var b1_ui = ui.child_at(col_ui, 0)
    var b1 = ui_bridge.node_of_ui(b1_ui)
    var b1r = tiu_tree.rect(b1)
    check("按钮一 x(pad)", b1r.x, 12)
    check("按钮一 y", b1r.y, 12)
    check("按钮一 w", b1r.w, 104)
    check("按钮一 h", b1r.h, 36)
    var b2_ui = ui.child_at(col_ui, 1)
    var b2 = ui_bridge.node_of_ui(b2_ui)
    var b2r = tiu_tree.rect(b2)
    check("按钮二 x", b2r.x, 12)
    check("按钮二 y(gap)", b2r.y, 56)
    check("按钮二 w", b2r.w, 104)
    check("按钮二 h", b2r.h, 36)
    println("---- element geometry: PASS=" + to_string(g_pass) + " FAIL=" + to_string(g_fail))
    if g_fail == 0 {
        println("element geometry ok")
    }
    return 0
}
