type tie<logic>
// tests/ui_bridge_probe.tie —— std/ui 描述层 → tiu 树 + 类型化属性的端到端探针
// EN: end-to-end probe for the std/ui → tiu bridge with typed layout properties.
// ============================================================
// 覆盖：元素块语法（window/label/row/button）→ std/ui 树 → 桥 → tiu 树 + props
//       → layout2 求解；文本折叠；窗口 size → 视口尺寸；pad/gap/fill 真的生效；
//       事件函数值经 tiu 节点反查后的派发。
// 编译（tie 仓根下，需支持第 14 章元素语法的新 tiec）：
//   TIE_LIB_ROOT=<tie 仓根> ./_local_only/bin/tiec.exe ../tiu/tests/ui_bridge_probe.tie -l2 -t0 -o out.exe
import "../ui/src/ui_bridge.tie"
import "../ui/src/tree.tie"
import "../ui/src/layout2.tie"

var g_hits: i64 = 0

// 事件处理器：签名与 std/ui 的函数值事件一致
func bump(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_hits = g_hits + 1
    return 7
}

func main() -> i64 {
    // 一、元素块：编译期降解为 ui.* 调用
    @ window "桥探针" (size: 320 x 200) {
        @ label "标题" (text: "hello")
        @ row (w: fill, pad: 8, gap: 4) {
            @ button "加" (text: "+1", w: fill, on_click: bump)
            @ button "减" (text: "-1", w: fill)
        }
    }

    // 二、std/ui 树已建好（窗口/标签/行/两个按钮；文本节点不占 UI 控件）
    var uic = ui.count()
    if uic != 5 {
        println("FAIL ui.count " + to_string(uic))
        return 1
    }

    // 三、桥：std/ui → tiu 树，并按类型化属性求解（文本节点折叠）
    var root = ui_bridge.build()
    if root < 0 {
        println("FAIL bridge root")
        return 1
    }
    var tc = tiu_tree.count()
    if tc != 5 {
        println("FAIL tiu.count " + to_string(tc))
        return 1
    }
    if tiu_tree.ty_of(root) != 1 {
        println("FAIL root type " + to_string(tiu_tree.ty_of(root)))
        return 1
    }
    if ui_bridge.window_w() != 320 || ui_bridge.window_h() != 200 {
        println("FAIL viewport " + to_string(ui_bridge.window_w()) + "x" + to_string(ui_bridge.window_h()))
        return 1
    }

    // 四、求解产物：根铺满视口（w/h 未写 → 按窗口语义 fill）
    var rr = tiu_tree.rect(root)
    if rr.w != 320 || rr.h != 200 {
        println("FAIL root rect " + to_string(rr.w) + "x" + to_string(rr.h))
        return 1
    }

    // 五、文本折叠：label 的文本来自子文本节点
    var lab = tiu_tree.first_child(root)
    if tiu_tree.text_of(lab) != "hello" {
        println("FAIL label text '" + tiu_tree.text_of(lab) + "'")
        return 1
    }

    // 六、pad / gap / w:fill 生效：行铺满视口（320），内容盒宽 = 320 - 2*8 = 304，
    //     两个 fill 按钮平分 (304 - 4) / 2 = 150，分别从 x=8 / x=162 起。
    var rowid = tiu_tree.next_sibling(lab)
    var row = tiu_tree.rect(rowid)
    println("cp: row rect x=" + to_string(row.x) + " y=" + to_string(row.y) + " w=" + to_string(row.w) + " h=" + to_string(row.h))
    if row.x != 0 {
        println("FAIL row x " + to_string(row.x))
        return 1
    }
    if row.w != 320 {
        println("FAIL row width " + to_string(row.w))
        return 1
    }
    var b1 = tiu_tree.first_child(rowid)
    var b2 = tiu_tree.next_sibling(b1)
    var r1 = tiu_tree.rect(b1)
    var r2 = tiu_tree.rect(b2)
    println("cp: b1 w=" + to_string(r1.w) + " x=" + to_string(r1.x) + " | b2 w=" + to_string(r2.w) + " x=" + to_string(r2.x))
    if r1.w != 150 || r2.w != 150 {
        println("FAIL fill split " + to_string(r1.w) + "/" + to_string(r2.w))
        return 1
    }
    if r1.x != 8 || r2.x != 162 {
        println("FAIL pad/gap x " + to_string(r1.x) + "/" + to_string(r2.x))
        return 1
    }
    if r1.y != row.y + 8 {
        println("FAIL pad top " + to_string(r1.y) + " row=" + to_string(row.y))
        return 1
    }
    if r1.x + r1.w + 4 != r2.x {
        println("FAIL gap " + to_string(r1.x + r1.w) + "->" + to_string(r2.x))
        return 1
    }

    // 七、事件派发：tiu 节点 → ui 节点 → 函数值处理器
    var uid = ui.find("加")
    println("cp: roots=" + to_string(ui.root_count()) + " count=" + to_string(ui.count()))
    println("cp: uid=" + to_string(uid) + " has=" + to_string(ui.has_fn_event(uid, "click")))
    if uid < 0 {
        println("FAIL ui.find")
        return 1
    }
    var tn = ui_bridge.node_of_ui(uid)
    if tn < 0 {
        println("FAIL node_of_ui")
        return 1
    }
    var hr = ui_bridge.dispatch(tn, "click", 5, 6, "tap")
    if hr != 7 {
        println("FAIL dispatch " + to_string(hr))
        return 1
    }
    if g_hits != 1 {
        println("FAIL hits " + to_string(g_hits))
        return 1
    }
    if ui_bridge.ui_id_of(tn) != uid {
        println("FAIL ui_id_of")
        return 1
    }

    println("ui bridge ok")
    return 0
}
