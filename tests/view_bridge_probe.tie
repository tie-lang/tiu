type tie<logic>
// tests/view_bridge_probe.tie —— 声明式视图层（vw）→ std/ui → 求解 → 绘制 → 事件
// ============================================================
// 收敛验收：vw 不再直接发 tiu_build 指令流，而是写 std/ui 的中立描述树，
// 与元素语法共用同一条下游管线（ui_bridge → layout2 → paint → raster）。
// 本探针因此在像素与事件两层断言：vw 视图真的被画出来、真的能被点。
//
// 编译（tie 仓根下）：
//   TIE_LIB_ROOT=<tie 仓根> ./_local_only/bin/tiec.exe ../tiu/tests/view_bridge_probe.tie \
//     -l2 -t0 --no-warn --no-cache -o ../tiu/_local_only/bin/view_bridge_probe.exe
// EN: probe proving the declarative view layer converges onto the same std/ui tree.

import "../ui/src/tree.tie"
import "../ui/src/props.tie"
import "../ui/src/theme.tie"
import "../ui/src/layout2.tie"
import "../ui/src/paint_state.tie"
import "../ui/src/paint_bridge.tie"
import "../ui/src/event.tie"
import "../ui/src/attr_parse.tie"
import "../ui/src/build.tie"
import "../ui/src/ui_bridge.tie"
import "../ui/src/view.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/drawlist.tie"
import "../api/src/canvas.tie"
import "../engine/src/semantics.tie"
import "../engine/src/font.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/eimg.tie"

const W: i64 = 320
const H: i64 = 220
const DPI: f64 = 1.0
const TH0: i64 = 0
const FONT_CONSULA: string = "C:/Windows/Fonts/consola.ttf"
const ACT_INC: i64 = 101

var g_pass: i64 = 0
var g_fail: i64 = 0

func ck(name: string, ok: bool, detail: string) {
    if ok {
        g_pass = g_pass + 1
        println("OK   " + name + " | " + detail)
    } else {
        g_fail = g_fail + 1
        println("FAIL " + name + " | " + detail)
    }
}

func px_at(fb: FrameBuf, x: i64, y: i64) -> i64 {
    if x < 0 || y < 0 || x >= fb.w || y >= fb.h {
        return 0
    }
    return fb.px[y * fb.w + x]
}

// 统计矩形内的「非底色」像素数（= 该区域真的画上了东西）
func ink_in(fb: FrameBuf, x0: i64, y0: i64, x1: i64, y1: i64, bg: i64) -> i64 {
    var n: i64 = 0
    var y = y0
    while y < y1 {
        var x = x0
        while x < x1 {
            if px_at(fb, x, y) != bg {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// 事件轴 sink：事件轴 → std/ui 函数值派发（与元素语法同一条路）
pub func sink(node: i64, name: string, x: i64, y: i64, kind: string) -> i64 {
    return ui_bridge.dispatch(node, name, x, y, kind)
}

// 待验视图：全部用 vw 组合子写，不摆任何手算矩形
func app() -> Elem {
    return Elem.Column([
        vw.Text("vw bridge"),
        vw.Spacer(8),
        Elem.Row([
            vw.Button("+1", ACT_INC),
            vw.Spacer(8),
            vw.Text("tail")
        ]),
        vw.Spacer(8),
        vw.Image(0, 40, 24)
    ])
}

func shot(th: i64, hot: i64) -> FrameBuf {
    var cv = cvs.new_offscreen(W, H, DPI)
    var d = cvs.record(cv)
    d = upaint.background(d, W, H, th)
    d = upaint.draw_state(d, th, hot, -1, -1)
    var ir = cvs.submit(cv, d)
    var p = eload.parse_frame(ir)
    return erast.render(p)
}

func find_kind(kind: string) -> i64 {
    var i: i64 = 0
    while i < ui.count() {
        if ui.kind_at(i) == kind {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

func main() -> i32 {
    erast.text_font(FONT_CONSULA)
    var face = erast.text_face_id()
    ck("字体装载", face >= 0, "face=" + to_string(face))
    upaint.set_text_face(face)

    // 1) vw → std/ui 中立树 → 布局求解
    var root = vw.mount_at(app(), W, H)
    ck("挂载出骨架", root >= 0, "root=" + to_string(root))
    ck("中立树节点齐备", ui.count() >= 9, "count=" + to_string(ui.count()))

    var bui = find_kind("button")
    var btn = ui_bridge.node_of_ui(bui)
    ck("按钮进树", bui >= 0, "ui=" + to_string(bui) + " node=" + to_string(btn))
    ck("动作码落到 tiu 节点", tiu_tree.act_of(btn) == ACT_INC, "act=" + to_string(tiu_tree.act_of(btn)))

    var r = tiu_tree.rect(btn)
    ck("按钮有真实尺寸", r.w > 0, "w=" + to_string(r.w))
    ck("按钮有真实高度", r.h > 0, "h=" + to_string(r.h))

    // 2) 绘制：同一条 paint 管线，断言像素
    var fb = shot(TH0, 0 - 1)
    var bg = uth.bg(TH0)
    var btn_ink = ink_in(fb, r.x, r.y, r.x + r.w, r.y + r.h, bg)
    ck("按钮画出墨迹", btn_ink > 40, "墨迹像素=" + to_string(btn_ink))

    // 文本子节点会被桥接折叠进父节点（不单独建 tiu 节点），因此取「有映射」的那个
    var ti: i64 = 0 - 1
    var tnode: i64 = 0 - 1
    var k: i64 = 0
    while k < ui.count() {
        if ui.kind_at(k) == "label" {
            var m = ui_bridge.node_of_ui(k)
            if m >= 0 {
                if tnode < 0 {
                    ti = k
                    tnode = m
                }
            }
        }
        k = k + 1
    }
    ck("文本节点可定位", tnode >= 0, "ui=" + to_string(ti) + " node=" + to_string(tnode))
    var tr = tiu_tree.rect(tnode)
    var text_ink = ink_in(fb, tr.x, tr.y, tr.x + tr.w, tr.y + tr.h, bg)
    ck("文本画出墨迹", text_ink > 20, "墨迹像素=" + to_string(text_ink))

    var ir_ui = find_kind("image")
    ck("图像节点进树", ir_ui >= 0, "ui=" + to_string(ir_ui))

    // 3) 事件：点击按钮 → vw 动作码（经事件轴与 std/ui 函数值，与元素语法同路）
    var cx = r.x + r.w / 2
    var cy = r.y + r.h / 2
    tiu_event.mouse_move(cx, cy, sink)
    tiu_event.mouse_down(cx, cy, 0, sink)
    tiu_event.mouse_up(cx, cy, 0, sink)
    var got = vw.take_action()
    ck("点击产出动作码", got == ACT_INC, "got=" + to_string(got))
    ck("动作取走即清空", vw.take_action() == 0, "second=" + to_string(vw.take_action()))

    // 4) hover 状态进入绘制：按钮在 hover 下观感不同（同一条绘制状态通路）
    tiu_event.mouse_move(cx, cy, sink)
    var fb_hot = shot(TH0, tiu_event.hover())
    var changed: i64 = 0
    var y = r.y
    while y < r.y + r.h {
        var x = r.x
        while x < r.x + r.w {
            if px_at(fb, x, y) != px_at(fb_hot, x, y) {
                changed = changed + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    ck("hover 改变按钮观感", changed > 0, "差异像素=" + to_string(changed))

    println("summary PASS=" + to_string(g_pass) + " FAIL=" + to_string(g_fail))
    if g_fail == 0 {
        println("view bridge ok")
        return 0
    }
    return 1
}
