type tie<logic>
// attr_parse_probe.tie —— 规范属性文本解析的自校验探针
// EN: self-check probe for canonical attribute text parsing.
// ============================================================
// 覆盖 `Size.to_attr` 的全部九种形态与长度/分布/溢出/锚点词表；
// 断言全部基于「解析结果 == 规范定义的数值」，不依赖任何绘制或字体。
//
// 编译（在 tie 仓根）：见 tests/README 或 _local_only 记录；运行输出 `attr parse ok`。

import "../ui/src/attr_parse.tie"

var g_fail: i64 = 0
var g_pass: i64 = 0

func eq_i(name: string, got: i64, want: i64) {
    if got == want {
        g_pass = g_pass + 1
        println("OK   " + name + " = " + to_string(got))
    } else {
        g_fail = g_fail + 1
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
    }
}

func main() -> i32 {
    // ---- 尺寸 kind ----
    eq_i("kind hug", aparse.size_kind("hug"), 0)
    eq_i("kind fill", aparse.size_kind("fill"), 1)
    eq_i("kind px", aparse.size_kind("480"), 2)
    eq_i("kind pct", aparse.size_kind("60%"), 3)
    eq_i("kind fr", aparse.size_kind("2fr"), 4)
    eq_i("kind em", aparse.size_kind("1.5em"), 5)
    eq_i("kind pt", aparse.size_kind("12pt"), 6)
    eq_i("kind vw", aparse.size_kind("50vw"), 7)
    eq_i("kind vh", aparse.size_kind("50vh"), 8)
    eq_i("kind ratio", aparse.size_kind("ratio(16:9)"), 9)

    // ---- 尺寸系数 a（百分之一）----
    eq_i("a px 480", aparse.size_a("480"), 48000)
    eq_i("a px 1.5", aparse.size_a("1.5"), 150)
    eq_i("a px 0.25", aparse.size_a("0.25"), 25)
    eq_i("a px -6", aparse.size_a("-6"), -600)
    eq_i("a pct 60", aparse.size_a("60%"), 6000)
    eq_i("a fr 2", aparse.size_a("2fr"), 200)
    eq_i("a fr 0.5", aparse.size_a("0.5fr"), 50)
    eq_i("a em 1.5", aparse.size_a("1.5em"), 150)
    eq_i("a pt 12", aparse.size_a("12pt"), 1200)
    eq_i("a vw 50", aparse.size_a("50vw"), 5000)
    eq_i("a vh 100", aparse.size_a("100vh"), 10000)
    eq_i("a ratio 16", aparse.size_a("ratio(16:9)"), 16)
    eq_i("b ratio 9", aparse.size_b("ratio(16:9)"), 9)
    eq_i("b ratio 4x3", aparse.size_b("ratio(4:3)"), 3)
    eq_i("b not ratio", aparse.size_b("2fr"), 0)
    eq_i("a hug", aparse.size_a("hug"), 0)
    eq_i("a fill", aparse.size_a("fill"), 0)

    // ---- 长度：四舍五入到整数像素 ----
    eq_i("len 12", aparse.len_of("12"), 12)
    eq_i("len -6", aparse.len_of("-6"), -6)
    eq_i("len 1.5", aparse.len_of("1.5"), 2)
    eq_i("len 0.4", aparse.len_of("0.4"), 0)
    eq_i("len 2.6", aparse.len_of("2.6"), 3)
    eq_i("len 16", aparse.len_of("16"), 16)

    // ---- 分布 / 溢出 / 锚点 ----
    eq_i("dist start", aparse.dist_code("start"), 0)
    eq_i("dist center", aparse.dist_code("center"), 1)
    eq_i("dist space-between", aparse.dist_code("space-between"), 3)
    eq_i("dist stretch", aparse.dist_code("stretch"), 6)
    eq_i("ov clip", aparse.overflow_code("clip"), 0)
    eq_i("ov scroll", aparse.overflow_code("scroll"), 1)
    eq_i("ov expand", aparse.overflow_code("expand"), 2)
    eq_i("ov error", aparse.overflow_code("error"), 3)
    eq_i("anchor top-start", aparse.anchor_code("top-start"), 0)
    eq_i("anchor center", aparse.anchor_code("center"), 4)
    eq_i("anchor bottom-end", aparse.anchor_code("bottom-end"), 8)
    eq_i("anchor fill", aparse.anchor_code("fill"), 9)

    // ---- 视口尺寸 ----
    eq_i("pair w", aparse.pair_w("480x320"), 480)
    eq_i("pair h", aparse.pair_h("480x320"), 320)
    eq_i("pair w 1", aparse.pair_w("1024x768"), 1024)
    eq_i("pair h 1", aparse.pair_h("1024x768"), 768)

    println("summary PASS=" + to_string(g_pass) + " FAIL=" + to_string(g_fail))
    if g_fail != 0 {
        return 1
    }
    println("attr parse ok")
    return 0
}
