type tie<logic>
// event_probe.tie —— 事件轴自校验探针
// EN: self-check probe for the event axis (records, hit cache, routing, focus, hover,
// wheel scrolling).
// ============================================================
// 断言全部基于「树 + 布局矩形 + 事件轴记账」，不依赖绘制、字体与宿主；
// 路由终点用本文件内的计数 sink 承接，从而单测阶段顺序与传播停止语义。
// 输出 `event axis ok`。

import "../ui/src/event.tie"

var g_fail: i64 = 0
var g_pass: i64 = 0

// sink 记账
var g_calls: i64 = 0
var g_last_node: i64 = 0 - 1
var g_last_name: string = ""
var g_last_phase: string = ""
var g_first_phase: string = ""
var g_root_capture: i64 = 0
var g_order: table<i64> = []
// 让目标节点（按钮）在收到 click 时「已处理」，用于验证传播停止。
var g_stop_node: i64 = 0 - 1

pub func sink(node: i64, name: string, x: i64, y: i64, phase: string) -> i64 {
    g_calls = g_calls + 1
    g_last_node = node
    g_last_name = name
    g_last_phase = phase
    if g_first_phase == "" {
        g_first_phase = phase
    }
    table_push(g_order, node)
    if phase == "capture" {
        g_root_capture = g_root_capture + 1
    }
    if node == g_stop_node && phase == "target" {
        return 1
    }
    return 0
}

func eq_i(name: string, got: i64, want: i64) {
    if got == want {
        g_pass = g_pass + 1
        println("OK   " + name + " = " + to_string(got))
    } else {
        g_fail = g_fail + 1
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
    }
}

func eq_b(name: string, got: bool) {
    if got {
        g_pass = g_pass + 1
        println("OK   " + name)
    } else {
        g_fail = g_fail + 1
        println("FAIL " + name)
    }
}

func eq_s(name: string, got: string, want: string) {
    if got == want {
        g_pass = g_pass + 1
        println("OK   " + name + " = " + got)
    } else {
        g_fail = g_fail + 1
        println("FAIL " + name + " got=" + got + " want=" + want)
    }
}

func main() -> i32 {
    // ---- 建树：列根 + 两个按钮 + 输入框 + 滚动容器（内含一个子节点）----
    tiu_tree.reset()
    var root = tiu_tree.mount(0 - 1, 0 - 1, WidgetType.Column)
    tiu_tree.set_rect(root, 0, 0, 320, 200)
    var b1 = tiu_tree.mount(root, 0, WidgetType.Button)
    tiu_tree.set_rect(b1, 8, 8, 100, 32)
    var b2 = tiu_tree.mount(root, 1, WidgetType.Button)
    tiu_tree.set_rect(b2, 120, 8, 100, 32)
    var inp = tiu_tree.mount(root, 2, WidgetType.TextInput)
    tiu_tree.set_rect(inp, 8, 60, 200, 32)
    var sc = tiu_tree.mount(root, 3, WidgetType.Scroll)
    tiu_tree.set_rect(sc, 8, 100, 300, 80)
    var inner = tiu_tree.mount(sc, 0, WidgetType.Text)
    tiu_tree.set_rect(inner, 8, 110, 300, 40)

    tiu_event.reset()
    tiu_event.layout_changed()

    // ---- 一、命中与缓存 ----
    eq_i("命中 b1", tiu_event.hit(50, 20), b1)
    eq_i("首次命中远算", tiu_event.stat_hits(), 1)
    eq_i("同点复用缓存", tiu_event.hit(50, 20), b1)
    eq_i("缓存命中计数", tiu_event.stat_cache_hits(), 1)
    eq_i("远算次数未增", tiu_event.stat_hits(), 1)
    tiu_event.layout_changed()
    eq_i("失效后同点远算", tiu_event.hit(50, 20), b1)
    eq_i("远算次数 +1", tiu_event.stat_hits(), 2)
    eq_i("视口内空白命中根", tiu_event.hit(300, 190), root)
    eq_i("视口外未命中", tiu_event.hit(400, 260), 0 - 1)
    eq_i("滚动容器内命中子节点", tiu_event.hit(100, 120), inner)

    // ---- 二、悬停（低噪声）----
    eq_i("移入 b1", tiu_event.mouse_move(50, 20, sink), b1)
    eq_i("hover = b1", tiu_event.hover(), b1)
    eq_s("首个悬停事件", g_last_name, "move")
    var before = tiu_event.stat_dispatched()
    tiu_event.mouse_move(52, 22, sink)
    eq_i("同一节点内移动不产生 hover 迁移", tiu_event.hover(), b1)
    tiu_event.mouse_move(150, 20, sink)
    eq_i("移入 b2 后 hover = b2", tiu_event.hover(), b2)
    eq_s("hover_out 先于 move 派发", g_last_name, "move")
    eq_b("派发次数只增不减", tiu_event.stat_dispatched() >= before)

    // ---- 三、捕获 → 目标 → 冒泡（阶段顺序）----
    tiu_event.reset_stats()
    g_order = table_new_i64()
    g_first_phase = ""
    tiu_event.mouse_down(50, 20, 0, sink)
    eq_i("按下后焦点 = b1", tiu_event.focus(), b1)
    eq_s("首阶段是捕获", g_first_phase, "capture")
    eq_b("捕获命中祖先（根）", g_root_capture >= 1)
    eq_i("链首元素是目标 b1", g_order[0], root)
    eq_i("按下路由末元素是根", g_order[len(g_order) - 1], root)

    // ---- 四、点击合成与传播停止 ----
    tiu_event.reset_stats()
    g_calls = 0
    tiu_event.mouse_up(50, 20, 0, sink)
    eq_i("同点抬起合成点击", tiu_event.click_count(), 1)
    eq_i("点击目标 = b1", tiu_event.click_node(), b1)
    tiu_event.reset_stats()
    tiu_event.mouse_down(50, 20, 0, sink)
    tiu_event.mouse_up(150, 20, 0, sink)
    eq_i("异点抬起不合成点击", tiu_event.click_count(), 0)
    g_stop_node = b2
    // 先把焦点放到 b2，避免焦点迁移事件计入本次派发数。
    tiu_event.set_focus_at(b2, sink)
    tiu_event.reset_stats()
    tiu_event.mouse_down(150, 20, 0, sink)
    eq_i("目标返回非 0 即停止传播", tiu_event.stat_dispatched(), 2)
    eq_i("停止后冒泡未发生", tiu_event.stat_handled(), 1)
    g_stop_node = 0 - 1

    // ---- 五、焦点循环（Tab / Shift+Tab）----
    // 从 b1 出发，DFS 序为 b1 → b2 → 输入框。
    tiu_event.set_focus_at(b1, sink)
    tiu_event.reset_stats()
    eq_i("Tab 前进到 b2", tiu_event.focus_next(sink), b2)
    eq_i("Tab 再前进到输入框", tiu_event.focus_next(sink), inp)
    eq_i("Tab 回卷到 b1", tiu_event.focus_next(sink), b1)
    eq_i("Shift+Tab 回退到输入框", tiu_event.focus_prev(sink), inp)

    // ---- 六、键盘路由到焦点 ----
    tiu_event.set_focus_at(b1, sink)
    tiu_event.reset_stats()
    eq_i("按键路由到焦点", tiu_event.key(tiu_event.e_key_down(), 65, sink), b1)
    eq_s("键盘事件名", g_last_name, "key_down")
    eq_b("键盘载荷", tiu_event.stat_dispatched() >= 1)
    tiu_event.reset_stats()
    eq_i("Tab 由键盘入口前进", tiu_event.key(tiu_event.e_key_down(), 9, sink), b2)

    // ---- 七、滚轮滚动 ----
    tiu_event.reset_stats()
    var before_off = tiu_tree.scroll_of(sc)
    var who = tiu_event.wheel(100, 120, 1, 24, sink)
    eq_i("滚轮命中滚动容器", who, sc)
    eq_i("滚动偏移按步长增加", tiu_tree.scroll_of(sc), before_off + 24)
    eq_s("滚动事件名", g_last_name, "scroll")
    var neg = tiu_tree.scroll_of(sc)
    tiu_event.wheel(100, 120, 0 - 3, 24, sink)
    eq_i("上滚钳到 0", tiu_tree.scroll_of(sc), 0)
    eq_i("滚动前偏移正确", neg, 24)
    eq_i("无滚动容器处滚轮返回 -1", tiu_event.wheel(50, 20, 1, 24, sink), 0 - 1)

    // ---- 八、重置 ----
    tiu_event.reset()
    eq_i("重置后焦点清空", tiu_event.focus(), 0 - 1)
    eq_i("重置后悬停清空", tiu_event.hover(), 0 - 1)
    eq_i("重置后记账清零", tiu_event.stat_events(), 0)

    println("summary pass=" + to_string(g_pass) + " fail=" + to_string(g_fail))
    if g_fail == 0 {
        println("event axis ok")
        return 0
    }
    return 1
}
