type tie<logic, unsafe:mem>
// examples/gallery_element.tie —— tiu 示例：组件画廊（元素语法 + 统一帧循环）
// ============================================================
// EN: tiu sample — a small widget gallery written in element syntax on the
// unified frame loop.
//
// 一屏之内把 tiu 的分层走一遍，且不手算任何坐标：
//   元素语法  @ window / @ column / @ row / @ panel / @ text / @ button
//             tiec 降解成 std/ui 中立描述树（ui.begin / attr_* / on / end）
//   std/ui    只描述「有什么控件、什么属性、什么事件」，不认识像素
//   ui_bridge 中立树 → tiu 骨架 + 类型化属性，并驱动布局求解
//   layout2   fill / hug / 百分比 / 间距 / 内边距 / 轴分布
//   paint     卡片、圆角、描边、文本（TTF + 回退链）、裁剪
//   raster    软件光栅 → 帧缓冲 → 宿主上屏
//
// 颜色属性（bg / fg / border）取主题 token 名，不写字面色值：
//   bg / surface / surface-alt / border / border-strong / separator /
//   accent / accent-hot / accent-down / accent-soft / fg / fg-dim /
//   on-accent / shadow / hover / transparent，也可写 #RRGGBB。
//
// 运行（tiu 仓根，先跑 examples/build.tie 构建）：
//   gallery_element.exe           打开窗口，关窗退出
//   gallery_element.exe --demo    跑 120 轮自动退出
//   gallery_element.exe --check   无窗口自检：同一条帧循环 + 像素断言
//   gallery_element.exe --shot p  无窗口渲染一帧写 PNG

import "../ui/src/window_host.tie"
import "../ui/src/tree.tie"
import "../ui/src/ui_bridge.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/canvas.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/pngout.tie"
import "../engine/src/present.tie"
import "../host/src/win.tie"
import "/std/args.tie"

const W: i64 = 560
const H: i64 = 420
const FONT: string = "C:/Windows/Fonts/consola.ttf"
// 主面是等宽英文字体，不含 CJK 字形；中文由回退链补字。
const FALLBACK: string = "C:/Windows/Fonts/Deng.ttf"

// ---- 应用状态（应用层持有，框架不托管状态）----
var g_count: i64 = 0
var g_pick: string = "选项 A"
var g_frames: i64 = 0

// ---- 事件处理器：签名由 std/ui 约定 (节点, x, y, 事件名) -> i64 ----
func on_inc(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_count = g_count + 1
    return 1
}

func on_dec(id: i64, x: i64, y: i64, kind: string) -> i64 {
    if g_count > 0 {
        g_count = g_count - 1
    }
    return 1
}

func on_reset(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_count = 0
    return 1
}

func on_pick_a(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_pick = "选项 A"
    return 1
}

func on_pick_b(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_pick = "选项 B"
    return 1
}

func on_pick_c(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_pick = "选项 C"
    return 1
}

// 列表行的配色不靠运行时拼接：选不选中渲染两棵不同的子树。
// （`bg` 是字面量属性键，值在编译期捕获；要随状态变化就换渲染分支。）

// ---- 视图：整棵树用元素语法写 ----
pub func view() -> i64 {
    g_frames = g_frames + 1
    ui.reset()
    @ window "tiu · 组件画廊" (size: 560x420, bg: "bg") {
        @ column "root" (w: fill, h: fill, pad: 24, gap: 18) {
            // 页头：标题 / 副标题 / 右侧状态徽标
            @ row "head" (w: fill, x: space-between, y: center, gap: 16) {
                @ column "titles" (gap: 6) {
                    @ label "title" (text: "tiu · 组件画廊", font-size: 22, fg: "fg")
                    @ label "sub" (text: "元素语法 · 布局求解 · 绘制桥 · 事件轴", font-size: 13, fg: "fg-dim")
                }
                @ row "chip" (bg: "accent-soft", radius: 8, pad-x: 10, pad-y: 5, gap: 6, y: center) {
                    @ label "chipdot" (text: "●", font-size: 11, fg: "accent")
                    @ label "chiptxt" (text: "软件光栅", font-size: 12, fg: "accent")
                }
            }

            // 分隔线：1px 高的行，颜色取 separator
            @ row "line" (w: fill, h: 1, bg: "separator")

            // 主体：两张卡片
            @ row "body" (w: fill, h: fill, gap: 18, y: start) {
                // 卡片一：计数器
                @ panel "card1" (w: 1fr, bg: "surface", stroke: "border", radius: 12, pad: 18, gap: 12, y: start) {
                    @ label "s1" (text: "计数器", font-size: 13, fg: "fg-dim")
                    @ label "count" (text: "计数 " + to_string(g_count), font-size: 28, fg: "fg")
                    @ row "btns" (w: fill, gap: 8, y: end) {
                        @ button "inc" (text: "+1", w: 84, h: 34, on_click: on_inc)
                        @ button "dec" (text: "-1", w: 84, h: 34, bg: "transparent", stroke: "border-strong", fg: "fg", on_click: on_dec)
                        @ button "reset" (text: "归零", w: 84, h: 34, bg: "transparent", stroke: "border-strong", fg: "fg", on_click: on_reset)
                    }
                }

                // 卡片二：列表选择
                @ panel "card2" (w: 1fr, bg: "surface", stroke: "border", radius: 12, pad: 18, gap: 10, y: start) {
                    @ label "s2" (text: "列表 · 点击选择", font-size: 13, fg: "fg-dim")
                    @ scroll "items" (w: fill, h: 132, gap: 6, pad-right: 10, overflow: scroll) {
                        if g_pick == "选项 A" {
                            @ row "ra" (w: fill, h: 36, radius: 8, pad-x: 12, gap: 10, y: center, bg: "accent-soft", on_click: on_pick_a) {
                                @ row "ra_bar" (w: 3, h: fill, radius: 2, bg: "accent")
                                @ label "ra_txt" (text: "选项 A", font-size: 14, fg: "accent")
                            }
                        } else {
                            @ row "ra" (w: fill, h: 36, radius: 8, pad-x: 12, gap: 10, y: center, on_click: on_pick_a) {
                                @ row "ra_bar" (w: 3, h: fill, radius: 2, bg: "transparent")
                                @ label "ra_txt" (text: "选项 A", font-size: 14, fg: "fg")
                            }
                        }
                        if g_pick == "选项 B" {
                            @ row "rb" (w: fill, h: 36, radius: 8, pad-x: 12, gap: 10, y: center, bg: "accent-soft", on_click: on_pick_b) {
                                @ row "rb_bar" (w: 3, h: fill, radius: 2, bg: "accent")
                                @ label "rb_txt" (text: "选项 B", font-size: 14, fg: "accent")
                            }
                        } else {
                            @ row "rb" (w: fill, h: 36, radius: 8, pad-x: 12, gap: 10, y: center, on_click: on_pick_b) {
                                @ row "rb_bar" (w: 3, h: fill, radius: 2, bg: "transparent")
                                @ label "rb_txt" (text: "选项 B", font-size: 14, fg: "fg")
                            }
                        }
                        if g_pick == "选项 C" {
                            @ row "rc" (w: fill, h: 36, radius: 8, pad-x: 12, gap: 10, y: center, bg: "accent-soft", on_click: on_pick_c) {
                                @ row "rc_bar" (w: 3, h: fill, radius: 2, bg: "accent")
                                @ label "rc_txt" (text: "选项 C", font-size: 14, fg: "accent")
                            }
                        } else {
                            @ row "rc" (w: fill, h: 36, radius: 8, pad-x: 12, gap: 10, y: center, on_click: on_pick_c) {
                                @ row "rc_bar" (w: 3, h: fill, radius: 2, bg: "transparent")
                                @ label "rc_txt" (text: "选项 C", font-size: 14, fg: "fg")
                            }
                        }
                        @ row "rd" (w: fill, h: 36, radius: 8, pad-x: 12, y: center, bg: "surface-alt") {
                            @ label "rd_txt" (text: "选项 D · 只在滚动区里", font-size: 14, fg: "fg-dim")
                        }
                        @ row "re" (w: fill, h: 36, radius: 8, pad-x: 12, y: center, bg: "surface-alt") {
                            @ label "re_txt" (text: "选项 E · 滚轮试试", font-size: 14, fg: "fg-dim")
                        }
                        @ row "rf" (w: fill, h: 36, radius: 8, pad-x: 12, y: center, bg: "surface-alt") {
                            @ label "rf_txt" (text: "选项 F · 最近一条", font-size: 14, fg: "fg-dim")
                        }
                    }
                    @ label "picked" (text: "当前选中：" + g_pick, font-size: 13, fg: "fg-dim")
                }
            }

            // 页脚
            @ row "foot" (w: fill, x: space-between, y: end) {
                @ label "ver" (text: "tiu ui · software raster · TTF 文本", font-size: 12, fg: "fg-dim")
                @ label "hint2" (text: "点击「+1」或列表项试试", font-size: 12, fg: "fg-dim")
            }
        }
    }
    return ui.count()
}

// ---- 自检：不建窗口，但走与真实运行完全相同的 frame/render ----
func check() -> i64 {
    tiu_win.theme(0)
    var face = tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    if face < 0 {
        println("FAIL 字体装载")
        return 1
    }
    var bad: i64 = 0

    var segs = tiu_win.frame(W, H, view)
    if segs <= 0 {
        println("FAIL 首帧无绘制段 segs=" + to_string(segs))
        bad = bad + 1
    }
    var fb = tiu_win.render(W, H)
    var bg = tiu_win.px(fb, 1, 1)
    if bg != 0xFF12141A {
        println("FAIL 窗口底色不是 bg token px=" + to_string(bg))
        bad = bad + 1
    } else {
        println("OK 窗口底色 bg token")
    }

    // 1) 按钮真的画出墨迹，且矩形来自布局求解
    var inc = ui_bridge.node_of_ui(ui.find("inc"))
    var r = tiu_tree.rect(inc)
    var ink = tiu_win.ink(fb, r.x + 3, r.y + 3, r.w - 6, r.h - 6, bg)
    if ink <= 0 {
        println("FAIL 按钮无墨迹 rect=" + to_string(r.x) + "," + to_string(r.y) + " " + to_string(r.w) + "x" + to_string(r.h))
        bad = bad + 1
    } else {
        println("OK 按钮有墨迹 ink=" + to_string(ink) + " rect=" + to_string(r.x) + "," + to_string(r.y) + " " + to_string(r.w) + "x" + to_string(r.h))
    }

    // 2) 卡片铺的是 surface 底色（取卡片右下角内侧，避开文字）
    var card = ui_bridge.node_of_ui(ui.find("card1"))
    var rc = tiu_tree.rect(card)
    var cpx = tiu_win.px(fb, rc.x + rc.w - 6, rc.y + rc.h - 6)
    if cpx != 0xFF191C23 {
        println("FAIL 卡片底色不是 surface px=" + to_string(cpx))
        bad = bad + 1
    } else {
        println("OK 卡片底色 surface rect=" + to_string(rc.x) + "," + to_string(rc.y) + " " + to_string(rc.w) + "x" + to_string(rc.h))
    }

    // 3) 点击走事件轴 → 状态变化 → 下一帧文本更新
    var cx = r.x + r.w / 2
    var cy = r.y + r.h / 2
    tiu_app.on_mouse_move(cx, cy)
    tiu_app.on_mouse_down(cx, cy)
    tiu_app.on_mouse_up(cx, cy)
    var segs2 = tiu_win.frame(W, H, view)
    var txt = ui.attr_of(ui.find("count"), "text")
    if g_count != 1 {
        println("FAIL 计数未增加 count=" + to_string(g_count))
        bad = bad + 1
    } else if txt != "计数 1" {
        println("FAIL 文本未更新 text=" + txt)
        bad = bad + 1
    } else if segs2 <= 0 {
        println("FAIL 事件帧无绘制段")
        bad = bad + 1
    } else {
        println("OK 点击后重绘 segs=" + to_string(segs2) + " text=" + txt)
    }

    // 4) 列表项点击：选中进状态，且选中行铺 accent-soft
    var pb = ui_bridge.node_of_ui(ui.find("rb"))
    var rb = tiu_tree.rect(pb)
    var mx = rb.x + rb.w / 2
    var my = rb.y + rb.h / 2
    tiu_app.on_mouse_move(mx, my)
    tiu_app.on_mouse_down(mx, my)
    tiu_app.on_mouse_up(mx, my)
    // 采样前把指针移开：行处于 hover 时会叠加高亮，届时像素不等于基准色。
    tiu_app.on_mouse_move(2, 2)
    tiu_win.frame(W, H, view)
    var fb2 = tiu_win.render(W, H)
    var picked = ui.attr_of(ui.find("picked"), "text")
    var rb2 = tiu_tree.rect(ui_bridge.node_of_ui(ui.find("rb")))
    var spx = tiu_win.px(fb2, rb2.x + rb2.w - 6, rb2.y + rb2.h / 2)
    if g_pick != "选项 B" {
        println("FAIL 列表选择未生效 pick=" + g_pick)
        bad = bad + 1
    } else if spx != 0xFF1B2A45 {
        println("FAIL 选中行底色不是 accent-soft px=" + to_string(spx))
        bad = bad + 1
    } else {
        println("OK 列表选择 picked=" + picked)
    }

    // 5) 空闲帧零重绘：无事件、无状态变化就不产生绘制段
    var segs3 = tiu_win.frame(W, H, view)
    if segs3 != 0 {
        println("FAIL 空闲帧仍有绘制段 segs=" + to_string(segs3))
        bad = bad + 1
    } else {
        println("OK 空闲帧零段 " + tiu_win.report())
    }

    // 6) 滚轮：悬停在滚动列表上滚一格，滚动量与画面都要变
    var items = ui_bridge.node_of_ui(ui.find("items"))
    var rb3 = tiu_tree.rect(items)
    var fb3 = tiu_win.render(W, H)
    var bpx = tiu_win.px(fb3, rb3.x + 6, rb3.y + 6)
    tiu_app.on_wheel(rb3.x + rb3.w / 2, rb3.y + 20, 3)
    var off3 = tiu_tree.scroll_of(items)
    var fb4 = tiu_win.render(W, H)
    var apx = tiu_win.px(fb4, rb3.x + 6, rb3.y + 6)
    if off3 <= 0 {
        println("FAIL 滚轮未改变滚动量 off=" + to_string(off3))
        bad = bad + 1
    } else if bpx == apx {
        println("FAIL 滚动后画面未变化 px=" + to_string(bpx))
        bad = bad + 1
    } else {
        println("OK 滚轮滚动 off=" + to_string(off3) + " 画面已变")
    }

    if bad == 0 {
        println("gallery ok")
    }
    return bad
}

func main() -> i64 {
    if args.has("--check") {
        return check()
    }
    if args.has("--shot") {
        // 无窗口截图：同一帧循环跑一帧，把像素写成 PNG（文档与视觉回归用）。
        tiu_win.theme(0)
        tiu_win.load_font(FONT)
        tiu_win.load_fallback(FALLBACK)
        tiu_win.frame(W, H, view)
        var fb = tiu_win.render(W, H)
        var path = args.value("--shot")
        if epng.save(fb, path) {
            println("shot " + path)
            return 0
        }
        println("FAIL 截图写盘失败 " + path)
        return 1
    }
    var rounds: i64 = 0
    if args.has("--demo") {
        rounds = 120
    }
    tiu_win.theme(0)
    tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    return tiu_win_host.run("tiu · 组件画廊", W, H, rounds, view)
}
