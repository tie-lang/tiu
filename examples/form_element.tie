type tie<logic, unsafe:mem>
// form_element.tie —— 元素语法表单示例：输入框、提交按钮、校验提示随状态重算。
// ============================================================
// 用法（tiu 仓根）：
//   _local_only\build\host\form_element.exe            一直运行到关窗
//   _local_only\build\host\form_element.exe --demo     跑 90 轮后自动退出
//   _local_only\build\host\form_element.exe --check    无窗口自检：帧循环 + 事件轴 + 像素断言
//
// 输入内容由外部赋值（g_user / g_mail）驱动；提交走函数值事件（on_click: on_submit）。
//
// EN: element-syntax form demo on the unified frame loop.
import "../ui/src/window_host.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/canvas.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/present.tie"
import "../engine/src/pngout.tie"
import "../host/src/win.tie"
import "/std/args.tie"

const W: i64 = 380
const H: i64 = 340
const FONT: string = "C:/Windows/Fonts/consola.ttf"
const FALLBACK: string = "C:/Windows/Fonts/Deng.ttf"

var g_user: string = ""
var g_mail: string = ""
var g_msg: string = "请填写用户名与邮箱"
var g_bad: i64 = 0

func on_submit(id: i64, x: i64, y: i64, kind: string) -> i64 {
    if str_len(g_user) == 0 {
        g_msg = "用户名不能为空"
        g_bad = 1
        return 1
    }
    if str_len(g_mail) == 0 {
        g_msg = "邮箱不能为空"
        g_bad = 1
        return 1
    }
    g_msg = "已提交：" + g_user + " <" + g_mail + ">"
    g_bad = 0
    return 1
}

pub func view() -> i64 {
    ui.reset()
    @ window "tiu · form" (size: 380x340) {
        @ column "root" (w: fill, h: fill, pad: 20, gap: 14) {
            @ row "head" (w: fill, x: space-between, y: center) {
                @ label "title" (text: "注册", font-size: 20)
                @ label "chip" (text: "表单校验", font-size: 12, h: 22, fg: "accent", bg: "accent-soft", radius: 6, pad-x: 8)
            }
            @ panel "card" (w: fill, h: fill, bg: "surface", stroke: "border", radius: 14, pad: 20, gap: 8, y: start) {
                @ label "lu" (text: "用户名", font-size: 12, fg: "fg-dim")
                @ input "user" (w: fill, h: 36, radius: 8, bg: "surface-alt", stroke: "border", pad-x: 12, placeholder: "用户名", value: g_user)
                @ label "lm" (text: "邮箱", font-size: 12, fg: "fg-dim")
                @ input "mail" (w: fill, h: 36, radius: 8, bg: "surface-alt", stroke: "border", pad-x: 12, placeholder: "邮箱", value: g_mail)
                if g_bad == 0 {
                    @ label "msg" (text: g_msg, font-size: 13, fg: "fg-dim") { }
                } else {
                    @ label "msg" (text: g_msg, font-size: 13, fg: "accent-down") { }
                }
                @ row "line" (w: fill, h: 1, bg: "separator")
                @ row "actions" (w: fill, gap: 10, y: end) {
                    @ button "submit" (w: 120, h: 38, radius: 9, text: "提交", on_click: on_submit) { }
                    @ label "tip" (text: "两项均为必填", font-size: 12, fg: "fg-dim")
                }
            }
            @ label "foot" (text: "tiu ui · 软件光栅 · TTF 文本", font-size: 11, fg: "fg-dim")
        }
    }
    return ui.count()
}

// 自检：同一帧循环，不建窗口。
func check() -> i64 {
    tiu_win.theme(0)
    var face = tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    if face < 0 {
        println("FAIL 字体装载")
        return 1
    }
    var bad: i64 = 0
    g_user = "jiro"
    g_mail = ""
    var segs = tiu_win.frame(W, H, view)
    var fb = tiu_win.render(W, H)
    var submit = ui_bridge.node_of_ui(ui.find("submit"))
    var ink = tiu_win.node_ink(fb, submit)
    if segs <= 0 || ink <= 0 {
        println("FAIL 首帧或按钮墨迹 segs=" + to_string(segs) + " ink=" + to_string(ink))
        bad = bad + 1
    } else {
        println("OK 首帧 segs=" + to_string(segs) + " 按钮墨迹=" + to_string(ink))
    }
    // 卡片底色必须与窗口底色不同（视觉系统生效）
    var card = ui_bridge.node_of_ui(ui.find("card"))
    var cr = tiu_tree.rect(card)
    var bg = tiu_win.px(fb, 1, 1)
    var cpx = tiu_win.px(fb, cr.x + 12, cr.y + cr.h / 2)
    if cpx == bg {
        println("FAIL 卡片底色与窗口底色相同")
        bad = bad + 1
    } else {
        println("OK 卡片底色 " + to_string(cpx))
    }
    // 缺邮箱：点击应被拒
    tiu_win.click_node(submit)
    var segs2 = tiu_win.frame(W, H, view)
    var m1 = ui.attr_of(ui.find("msg"), "text")
    if g_bad != 1 || m1 != "邮箱不能为空" {
        println("FAIL 缺邮箱未拒 bad=" + to_string(g_bad) + " msg=" + m1)
        bad = bad + 1
    } else if segs2 <= 0 {
        println("FAIL 拒绝后无重绘")
        bad = bad + 1
    } else {
        println("OK 缺邮箱被拒：" + m1)
    }
    // 补齐邮箱：点击应通过
    g_mail = "jiro@example.com"
    tiu_win.frame(W, H, view)
    tiu_win.click_node(ui_bridge.node_of_ui(ui.find("submit")))
    tiu_win.frame(W, H, view)
    var m2 = ui.attr_of(ui.find("msg"), "text")
    if g_bad != 0 || !str_has(m2, "jiro@example.com") {
        println("FAIL 提交未通过 bad=" + to_string(g_bad) + " msg=" + m2)
        bad = bad + 1
    } else {
        println("OK 提交通过：" + m2)
    }
    // 空闲帧零段
    var segs3 = tiu_win.frame(W, H, view)
    if segs3 != 0 {
        println("FAIL 空闲帧仍有段 segs=" + to_string(segs3))
        bad = bad + 1
    }
    if bad == 0 {
        println("form element ok")
    }
    return bad
}

func main() -> i64 {
    if args.has("--check") {
        return check()
    }
    if args.has("--shot") {
        // 无窗口截图：同一帧循环跑一帧，把像素写成 PNG（文档与视觉回归用）。
        tiu_win.theme(0)
        tiu_win.load_font(FONT)
        tiu_win.load_fallback(FALLBACK)
        tiu_win.frame(W, H, view)
        var fb = tiu_win.render(W, H)
        var path = args.value("--shot")
        if epng.save(fb, path) {
            println("shot " + path)
            return 0
        }
        println("FAIL 截图写盘失败 " + path)
        return 1
    }
    var rounds: i64 = 0
    if args.has("--demo") {
        rounds = 90
    }
    g_user = "jiro"
    tiu_win.theme(0)
    tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    var rc = tiu_win_host.run("tiu · form", W, H, rounds, view)
    if rc == 0 {
        println("form 关闭：rounds=" + to_string(tiu_win_host.rounds()) + " presented=" + to_string(tiu_win_host.presented()))
    }
    return rc
}
