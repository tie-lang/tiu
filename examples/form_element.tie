type tie<logic, unsafe:mem>
// form_element.tie —— 元素语法表单示例：输入框、提交按钮、校验提示随状态重算。
// ============================================================
// 用法（tiu 仓根）：
//   build\host\form_element.exe            一直运行到关窗
//   build\host\form_element.exe --demo     跑 90 轮后自动退出
//   build\host\form_element.exe --check    无窗口自检：帧循环 + 事件轴 + 像素断言
//
// 输入内容由外部赋值（g_user / g_mail）驱动；提交走函数值事件（on_click: on_submit）。
//
// EN: element-syntax form demo on the unified frame loop.
import "../ui/src/window_host.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/canvas.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/present.tie"
import "../host/src/win.tie"
import "/std/args.tie"

const W: i64 = 360
const H: i64 = 300
const FONT: string = "C:/Windows/Fonts/consola.ttf"

var g_user: string = ""
var g_mail: string = ""
var g_msg: string = "请填写用户名与邮箱"
var g_bad: i64 = 0

func on_submit(id: i64, x: i64, y: i64, kind: string) -> i64 {
    if str_len(g_user) == 0 {
        g_msg = "用户名不能为空"
        g_bad = 1
        return 1
    }
    if str_len(g_mail) == 0 {
        g_msg = "邮箱不能为空"
        g_bad = 1
        return 1
    }
    g_msg = "已提交：" + g_user + " <" + g_mail + ">"
    g_bad = 0
    return 1
}

pub func view() -> i64 {
    ui.reset()
    @ window "tiu · form" (size: 360x300) {
        @ column "root" (w: fill, h: fill, pad: 16, gap: 10) {
            @ heading "title" (text: "注册")
            @ input "user" (w: fill, h: 32, placeholder: "用户名", value: g_user)
            @ input "mail" (w: fill, h: 32, placeholder: "邮箱", value: g_mail)
            @ label "msg" (text: g_msg)
            @ row "actions" (gap: 8) {
                @ button "submit" (w: 96, h: 34, text: "提交", on_click: on_submit) { }
            }
        }
    }
    return ui.count()
}

// 自检：同一帧循环，不建窗口。
func check() -> i64 {
    tiu_win.theme(0)
    var face = tiu_win.load_font(FONT)
    if face < 0 {
        println("FAIL 字体装载")
        return 1
    }
    var bad: i64 = 0
    g_user = "jiro"
    g_mail = ""
    var segs = tiu_win.frame(W, H, view)
    var fb = tiu_win.render(W, H)
    var submit = ui_bridge.node_of_ui(ui.find("submit"))
    var ink = tiu_win.node_ink(fb, submit)
    if segs <= 0 || ink <= 0 {
        println("FAIL 首帧或按钮墨迹 segs=" + to_string(segs) + " ink=" + to_string(ink))
        bad = bad + 1
    } else {
        println("OK 首帧 segs=" + to_string(segs) + " 按钮墨迹=" + to_string(ink))
    }
    // 缺邮箱：点击应被拒
    tiu_win.click_node(submit)
    var segs2 = tiu_win.frame(W, H, view)
    var m1 = ui.attr_of(ui.find("msg"), "text")
    if g_bad != 1 || m1 != "邮箱不能为空" {
        println("FAIL 缺邮箱未拒 bad=" + to_string(g_bad) + " msg=" + m1)
        bad = bad + 1
    } else if segs2 <= 0 {
        println("FAIL 拒绝后无重绘")
        bad = bad + 1
    } else {
        println("OK 缺邮箱被拒：" + m1)
    }
    // 补齐邮箱：点击应通过
    g_mail = "jiro@example.com"
    tiu_win.frame(W, H, view)
    tiu_win.click_node(ui_bridge.node_of_ui(ui.find("submit")))
    tiu_win.frame(W, H, view)
    var m2 = ui.attr_of(ui.find("msg"), "text")
    if g_bad != 0 || !str_has(m2, "jiro@example.com") {
        println("FAIL 提交未通过 bad=" + to_string(g_bad) + " msg=" + m2)
        bad = bad + 1
    } else {
        println("OK 提交通过：" + m2)
    }
    // 空闲帧零段
    var segs3 = tiu_win.frame(W, H, view)
    if segs3 != 0 {
        println("FAIL 空闲帧仍有段 segs=" + to_string(segs3))
        bad = bad + 1
    }
    if bad == 0 {
        println("form element ok")
    }
    return bad
}

func main() -> i64 {
    if args.has("--check") {
        return check()
    }
    var rounds: i64 = 0
    if args.has("--demo") {
        rounds = 90
    }
    g_user = "jiro"
    tiu_win.theme(0)
    tiu_win.load_font(FONT)
    var rc = tiu_win_host.run("tiu · form", W, H, rounds, view)
    if rc == 0 {
        println("form 关闭：rounds=" + to_string(tiu_win_host.rounds()) + " presented=" + to_string(tiu_win_host.presented()))
    }
    return rc
}
