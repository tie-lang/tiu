type tie<logic, unsafe:mem>
// list_element.tie —— 元素语法列表示例：控制流在元素体内生成行，删除按钮用函数值事件。
// ============================================================
// 用法（tiu 仓根）：
//   _local_only\build\host\list_element.exe            一直运行到关窗
//   _local_only\build\host\list_element.exe --demo     跑 90 轮后自动退出
//   _local_only\build\host\list_element.exe --check    无窗口自检：帧循环 + 事件轴 + 像素断言
//
// EN: element-syntax list demo on the unified frame loop.
import "../ui/src/window_host.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/canvas.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/present.tie"
import "../engine/src/pngout.tie"
import "../host/src/win.tie"
import "/std/args.tie"

const W: i64 = 380
const H: i64 = 360
const FONT: string = "C:/Windows/Fonts/consola.ttf"
const FALLBACK: string = "C:/Windows/Fonts/Deng.ttf"

var g_rows: i64 = 5

func on_del(id: i64, x: i64, y: i64, kind: string) -> i64 {
    if g_rows > 0 {
        g_rows = g_rows - 1
    }
    return 1
}

pub func view() -> i64 {
    ui.reset()
    var i: i64 = 0
    @ window "tiu · list" (size: 380x360) {
        @ column "root" (w: fill, h: fill, pad: 20, gap: 12) {
            @ row "head" (w: fill, x: space-between, y: center) {
                @ label "title" (text: "列表（" + to_string(g_rows) + " 项）", font-size: 18)
                @ label "chip" (text: "滚轮可滚动", font-size: 12, h: 22, fg: "accent", bg: "accent-soft", radius: 6, pad-x: 8)
            }
            @ panel "card" (w: fill, h: fill, bg: "surface", stroke: "border", radius: 14, pad: 12, gap: 0, y: start) {
                @ scroll "body" (w: fill, h: fill, gap: 6, pad-right: 10, overflow: scroll) {
                    while i < g_rows {
                        if i % 2 == 0 {
                            @ row "row" (w: fill, h: 40, radius: 8, pad-x: 12, gap: 10, y: center, bg: "surface-alt", x: space-between) {
                                @ label "txt" (text: "第 " + to_string(i + 1) + " 行", font-size: 14)
                                @ button "del" (w: 60, h: 28, radius: 7, text: "删除", font-size: 12, bg: "transparent", stroke: "border-strong", fg: "fg-dim", on_click: on_del) { }
                            }
                        } else {
                            @ row "row" (w: fill, h: 40, radius: 8, pad-x: 12, gap: 10, y: center, x: space-between) {
                                @ label "txt" (text: "第 " + to_string(i + 1) + " 行", font-size: 14)
                                @ button "del" (w: 60, h: 28, radius: 7, text: "删除", font-size: 12, bg: "transparent", stroke: "border-strong", fg: "fg-dim", on_click: on_del) { }
                            }
                        }
                        i = i + 1
                    }
                }
            }
            @ label "foot" (text: "tiu ui · 软件光栅 · TTF 文本", font-size: 11, fg: "fg-dim")
        }
    }
    return ui.count()
}

// 自检：同一帧循环，不建窗口。
func check() -> i64 {
    tiu_win.theme(0)
    var face = tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    if face < 0 {
        println("FAIL 字体装载")
        return 1
    }
    var bad: i64 = 0
    var segs = tiu_win.frame(W, H, view)
    var fb = tiu_win.render(W, H)
    var row = ui_bridge.node_of_ui(ui.find("row"))
    var ink = tiu_win.node_ink(fb, row)
    if segs <= 0 || ink <= 0 {
        println("FAIL 首帧或行墨迹 segs=" + to_string(segs) + " ink=" + to_string(ink))
        bad = bad + 1
    } else {
        println("OK 首帧 segs=" + to_string(segs) + " 首行墨迹=" + to_string(ink))
    }
    // 卡片底色必须与窗口底色不同（视觉系统生效）
    var card = ui_bridge.node_of_ui(ui.find("card"))
    var cr = tiu_tree.rect(card)
    var bg = tiu_win.px(fb, 1, 1)
    var cpx = tiu_win.px(fb, cr.x + 12, cr.y + cr.h / 2)
    if cpx == bg {
        println("FAIL 卡片底色与窗口底色相同")
        bad = bad + 1
    } else {
        println("OK 卡片底色 " + to_string(cpx))
    }
    var t0 = ui.attr_of(ui.find("title"), "text")
    if t0 != "列表（5 项）" {
        println("FAIL 初始标题 " + t0)
        bad = bad + 1
    }
    // 删除一行：点击第一行的删除按钮
    tiu_win.click_node(ui_bridge.node_of_ui(ui.find("del")))
    var segs2 = tiu_win.frame(W, H, view)
    var t1 = ui.attr_of(ui.find("title"), "text")
    if g_rows != 4 || t1 != "列表（4 项）" {
        println("FAIL 删除后 rows=" + to_string(g_rows) + " 标题=" + t1)
        bad = bad + 1
    } else if segs2 <= 0 {
        println("FAIL 删除后无重绘")
        bad = bad + 1
    } else {
        println("OK 删除后重绘 segs=" + to_string(segs2) + " " + t1)
    }
    var segs3 = tiu_win.frame(W, H, view)
    if segs3 != 0 {
        println("FAIL 空闲帧仍有段 segs=" + to_string(segs3))
        bad = bad + 1
    }
    if bad == 0 {
        println("list element ok")
    }
    return bad
}

func main() -> i64 {
    if args.has("--check") {
        return check()
    }
    if args.has("--shot") {
        // 无窗口截图：同一帧循环跑一帧，把像素写成 PNG（文档与视觉回归用）。
        tiu_win.theme(0)
        tiu_win.load_font(FONT)
        tiu_win.load_fallback(FALLBACK)
        tiu_win.frame(W, H, view)
        var fb = tiu_win.render(W, H)
        var path = args.value("--shot")
        if epng.save(fb, path) {
            println("shot " + path)
            return 0
        }
        println("FAIL 截图写盘失败 " + path)
        return 1
    }
    var rounds: i64 = 0
    if args.has("--demo") {
        rounds = 90
    }
    tiu_win.theme(0)
    tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    var rc = tiu_win_host.run("tiu · list", W, H, rounds, view)
    if rc == 0 {
        println("list 关闭：rounds=" + to_string(tiu_win_host.rounds()) + " presented=" + to_string(tiu_win_host.presented()))
    }
    return rc
}
