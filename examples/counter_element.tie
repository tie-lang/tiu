type tie<logic, unsafe:mem>
// counter_element.tie —— 元素语法计数器示例：真实窗口 + 统一帧循环。
// ============================================================
// 用法（tiu 仓根，下同）：
//   _local_only\build\host\counter_element.exe            一直运行到关窗
//   _local_only\build\host\counter_element.exe --demo     跑 90 轮后自动退出（冒烟/自演示）
//   _local_only\build\host\counter_element.exe --check    无窗口自检：同一条帧循环 + 像素断言
//
// 演示链路：元素语法写视图 → 帧循环重建/布局/差分 → 事件轴派发 → 状态变化 → 下一帧重绘。
//
// EN: element-syntax counter demo on the unified frame loop.
import "../ui/src/window_host.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/canvas.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/present.tie"
import "../engine/src/pngout.tie"
import "../host/src/win.tie"
import "/std/args.tie"

const W: i64 = 380
const H: i64 = 300
const FONT: string = "C:/Windows/Fonts/consola.ttf"
const FALLBACK: string = "C:/Windows/Fonts/Deng.ttf"

var g_count: i64 = 0

// 事件处理器签名与 std/ui 的函数值事件表一致：(节点, x, y, 事件名) -> i64
func on_inc(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_count = g_count + 1
    return 1
}

func on_dec(id: i64, x: i64, y: i64, kind: string) -> i64 {
    if g_count > 0 {
        g_count = g_count - 1
    }
    return 1
}

func on_reset(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_count = 0
    return 1
}

pub func view() -> i64 {
    ui.reset()
    @ window "tiu · counter" (size: 380x300) {
        @ column "root" (w: fill, h: fill, pad: 20, gap: 14) {
            @ row "head" (w: fill, x: space-between, y: center) {
                @ label "title" (text: "计数器", font-size: 20)
                @ label "chip" (text: "元素语法", font-size: 12, h: 22, fg: "accent", bg: "accent-soft", radius: 6, pad-x: 8)
            }
            @ panel "card" (w: fill, h: fill, bg: "surface", stroke: "border", radius: 14, pad: 20, gap: 10, y: start) {
                @ label "caption" (text: "当前计数", font-size: 13, fg: "fg-dim")
                @ label "value" (text: "计数 " + to_string(g_count), font-size: 40)
                @ label "hint" (text: "点击 +1 / -1 改变数值", font-size: 12, fg: "fg-dim")
                @ row "ops" (w: fill, gap: 10, y: end) {
                    @ button "inc" (w: 108, h: 38, radius: 9, text: "+1", on_click: on_inc) { }
                    @ button "dec" (w: 108, h: 38, radius: 9, text: "-1", bg: "transparent", stroke: "border-strong", fg: "fg", on_click: on_dec) { }
                    @ button "reset" (w: 108, h: 38, radius: 9, text: "归零", bg: "transparent", stroke: "border-strong", fg: "fg", on_click: on_reset) { }
                }
            }
            @ label "foot" (text: "tiu ui · 软件光栅 · TTF 文本", font-size: 11, fg: "fg-dim")
        }
    }
    return ui.count()
}

// 点一下某节点中心（走事件轴，与真实鼠标同一路径）
func click(id: i64) {
    var r = tiu_tree.rect(id)
    var cx = r.x + r.w / 2
    var cy = r.y + r.h / 2
    tiu_app.on_mouse_move(cx, cy)
    tiu_app.on_mouse_down(cx, cy)
    tiu_app.on_mouse_up(cx, cy)
}

// 自检：不建窗口，但走与真实运行完全相同的 frame/render。
func check() -> i64 {
    tiu_win.theme(0)
    var face = tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    if face < 0 {
        println("FAIL 字体装载")
        return 1
    }
    var bad: i64 = 0
    var segs = tiu_win.frame(W, H, view)
    if segs <= 0 {
        println("FAIL 首帧无段 segs=" + to_string(segs))
        bad = bad + 1
    }
    var fb = tiu_win.render(W, H)
    var bg = tiu_win.px(fb, 1, 1)
    var inc = ui_bridge.node_of_ui(ui.find("inc"))
    var r = tiu_tree.rect(inc)
    var ink = tiu_win.ink(fb, r.x + 4, r.y + 4, r.w - 8, r.h - 8, bg)
    if ink <= 0 {
        println("FAIL 按钮无墨迹 rect=" + to_string(r.x) + "," + to_string(r.y) + " " + to_string(r.w) + "x" + to_string(r.h))
        bad = bad + 1
    } else {
        println("OK 按钮有墨迹 ink=" + to_string(ink) + " rect=" + to_string(r.x) + "," + to_string(r.y) + " " + to_string(r.w) + "x" + to_string(r.h))
    }
    // 卡片底色与窗口底色必须可区分（视觉系统生效的证据）
    var card = ui_bridge.node_of_ui(ui.find("card"))
    var cr = tiu_tree.rect(card)
    var cpx = tiu_win.px(fb, cr.x + 12, cr.y + cr.h / 2)
    if cpx == bg {
        println("FAIL 卡片底色与窗口底色相同")
        bad = bad + 1
    } else {
        println("OK 卡片底色 " + to_string(cpx) + " 窗口 " + to_string(bg))
    }
    click(inc)
    var segs2 = tiu_win.frame(W, H, view)
    var txt = ui.attr_of(ui.find("value"), "text")
    if g_count != 1 {
        println("FAIL 计数未增加 count=" + to_string(g_count))
        bad = bad + 1
    } else if txt != "计数 1" {
        println("FAIL 文本未更新 text=" + txt)
        bad = bad + 1
    } else if segs2 <= 0 {
        println("FAIL 事件帧无段")
        bad = bad + 1
    } else {
        println("OK 点击后重绘 segs=" + to_string(segs2) + " " + txt)
    }
    // 空闲帧：无事件、无状态变化 → 零段（空闲零重绘）
    var segs3 = tiu_win.frame(W, H, view)
    if segs3 != 0 {
        println("FAIL 空闲帧仍有段 segs=" + to_string(segs3))
        bad = bad + 1
    } else {
        println("OK 空闲帧零段 " + tiu_win.report())
    }
    if bad == 0 {
        println("counter element ok")
    }
    return bad
}

func main() -> i64 {
    if args.has("--check") {
        return check()
    }
    if args.has("--shot") {
        // 无窗口截图：同一帧循环跑一帧，把像素写成 PNG（文档与视觉回归用）。
        tiu_win.theme(0)
        tiu_win.load_font(FONT)
        tiu_win.load_fallback(FALLBACK)
        tiu_win.frame(W, H, view)
        var fb = tiu_win.render(W, H)
        var path = args.value("--shot")
        if epng.save(fb, path) {
            println("shot " + path)
            return 0
        }
        println("FAIL 截图写盘失败 " + path)
        return 1
    }
    var rounds: i64 = 0
    if args.has("--demo") {
        rounds = 90
    }
    tiu_win.theme(0)
    tiu_win.load_font(FONT)
    tiu_win.load_fallback(FALLBACK)
    return tiu_win_host.run("tiu · counter", W, H, rounds, view)
}
