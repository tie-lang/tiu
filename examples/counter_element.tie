type tie<logic, unsafe:mem>
// counter_element.tie —— 元素语法计数器示例：真实窗口 + 统一帧循环。
// ============================================================
// 用法（tiu 仓根，下同）：
//   build\host\counter_element.exe            一直运行到关窗
//   build\host\counter_element.exe --demo     跑 90 轮后自动退出（冒烟/自演示）
//   build\host\counter_element.exe --check    无窗口自检：同一条帧循环 + 像素断言
//
// 演示链路：元素语法写视图 → 帧循环重建/布局/差分 → 事件轴派发 → 状态变化 → 下一帧重绘。
//
// EN: element-syntax counter demo on the unified frame loop.
import "../ui/src/window_host.tie"
import "../api/src/color.tie"
import "../api/src/paint.tie"
import "../api/src/canvas.tie"
import "../engine/src/ir_load.tie"
import "../engine/src/raster.tie"
import "../engine/src/present.tie"
import "../host/src/win.tie"
import "/std/args.tie"

const W: i64 = 360
const H: i64 = 260
const FONT: string = "C:/Windows/Fonts/consola.ttf"

var g_count: i64 = 0

// 事件处理器签名与 std/ui 的函数值事件表一致：(节点, x, y, 事件名) -> i64
func on_inc(id: i64, x: i64, y: i64, kind: string) -> i64 {
    g_count = g_count + 1
    return 1
}

func on_dec(id: i64, x: i64, y: i64, kind: string) -> i64 {
    if g_count > 0 {
        g_count = g_count - 1
    }
    return 1
}

pub func view() -> i64 {
    ui.reset()
    @ window "tiu · counter" (size: 360x260) {
        @ column "root" (w: fill, h: fill, pad: 16, gap: 8) {
            @ heading "title" (text: "Counter")
            @ label "value" (text: "计数 " + to_string(g_count))
            @ row "ops" (gap: 8) {
                @ button "inc" (w: 96, h: 32, text: "+1", on_click: on_inc) { }
                @ button "dec" (w: 96, h: 32, text: "-1", on_click: on_dec) { }
            }
        }
    }
    return ui.count()
}

// 点一下某节点中心（走事件轴，与真实鼠标同一路径）
func click(id: i64) {
    var r = tiu_tree.rect(id)
    var cx = r.x + r.w / 2
    var cy = r.y + r.h / 2
    tiu_app.on_mouse_move(cx, cy)
    tiu_app.on_mouse_down(cx, cy)
    tiu_app.on_mouse_up(cx, cy)
}

// 自检：不建窗口，但走与真实运行完全相同的 frame/render。
func check() -> i64 {
    tiu_win.theme(0)
    var face = tiu_win.load_font(FONT)
    if face < 0 {
        println("FAIL 字体装载")
        return 1
    }
    var bad: i64 = 0
    var segs = tiu_win.frame(W, H, view)
    if segs <= 0 {
        println("FAIL 首帧无段 segs=" + to_string(segs))
        bad = bad + 1
    }
    var fb = tiu_win.render(W, H)
    var bg = tiu_win.px(fb, 1, 1)
    var inc = ui_bridge.node_of_ui(ui.find("inc"))
    var r = tiu_tree.rect(inc)
    var ink = tiu_win.ink(fb, r.x + 4, r.y + 4, r.w - 8, r.h - 8, bg)
    if ink <= 0 {
        println("FAIL 按钮无墨迹 rect=" + to_string(r.x) + "," + to_string(r.y) + " " + to_string(r.w) + "x" + to_string(r.h))
        bad = bad + 1
    } else {
        println("OK 按钮有墨迹 ink=" + to_string(ink) + " rect=" + to_string(r.x) + "," + to_string(r.y) + " " + to_string(r.w) + "x" + to_string(r.h))
    }
    click(inc)
    var segs2 = tiu_win.frame(W, H, view)
    var txt = ui.attr_of(ui.find("value"), "text")
    if g_count != 1 {
        println("FAIL 计数未增加 count=" + to_string(g_count))
        bad = bad + 1
    } else if txt != "计数 1" {
        println("FAIL 文本未更新 text=" + txt)
        bad = bad + 1
    } else if segs2 <= 0 {
        println("FAIL 事件帧无段")
        bad = bad + 1
    } else {
        println("OK 点击后重绘 segs=" + to_string(segs2) + " " + txt)
    }
    // 空闲帧：无事件、无状态变化 → 零段（空闲零重绘）
    var segs3 = tiu_win.frame(W, H, view)
    if segs3 != 0 {
        println("FAIL 空闲帧仍有段 segs=" + to_string(segs3))
        bad = bad + 1
    } else {
        println("OK 空闲帧零段 " + tiu_win.report())
    }
    if bad == 0 {
        println("counter element ok")
    }
    return bad
}

func main() -> i64 {
    if args.has("--check") {
        return check()
    }
    var rounds: i64 = 0
    if args.has("--demo") {
        rounds = 90
    }
    tiu_win.theme(0)
    tiu_win.load_font(FONT)
    return tiu_win_host.run("tiu · counter", W, H, rounds, view)
}
