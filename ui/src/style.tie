type tie<class>
// style.tie —— 样式单元落地（把 `style 名 { 键: 值 ... }` 摊到引用它的元素上）
// style.tie — style units, flattened onto the elements that reference them.
// ============================================================
// 语法（见 docs/designs/tiu-layout-syntax.md §8）：
//
//   style card {
//       bg: surface
//       border: 1
//       radius: 12
//       pad: 16
//       gap: 10
//   }
//
//   @ panel "settings" (style: card, w: fill) { ... }
//
// 规则：
//   * 按名静态引用，没有选择器、没有 specificity、没有 !important。
//   * 合并顺序固定：元素内联属性 > 引用样式 > 控件默认值。
//     内联属性赢，是因为这里的做法是「只补节点没有的键」，
//     因此一旦某个元素显式写了 bg，样式里的 bg 就不会覆盖它。
//   * 声明之间用换行或分号分隔，键与值之间用第一个冒号分隔；
//     值保留原文（`surface`、`fill`、`12`、`ratio(16:9)` 都可），
//     语义解析一律交给 attr_parse/桥接，样式层不认识值的意思。
//
// EN: Style units are referenced by name, flattened onto nodes that carry
// EN: `style: <name>`; inline attributes always win, so the pass only fills
// EN: keys the node does not already declare.
import "/std/ui.tie" as ui

// 解析结果：三张平行表（样式名 / 键 / 值），按声明顺序。
var g_parsed: i64 = 0
var g_owner: table<string> = []
var g_key: table<string> = []
var g_val: table<string> = []

namespace tiu_style {

    func is_space(ch: string) -> bool {
        return ch == " " || ch == "\t" || ch == "\r" || ch == "\n"
    }

    // 声明分隔符：分号或换行。
    func is_decl_sep(ch: string) -> bool {
        return ch == ";" || ch == "\n"
    }

    // 去掉首尾空白。tie 没有 trim，逐码点拼一遍。
    func trim(s: string) -> string {
        var n = str_len(s)
        var b: i64 = 0
        while b < n && is_space(str_char(s, b)) {
            b = b + 1
        }
        var e = n
        while e > b && is_space(str_char(s, e - 1)) {
            e = e - 1
        }
        var out = ""
        var i = b
        while i < e {
            out = out + str_char(s, i)
            i = i + 1
        }
        return out
    }

    // 把一条样式载荷拆成（键, 值）对，顺序保留。
    func decl_parts(p: string) -> table<string> {
        var out = table_new_string()
        var n = str_len(p)
        var i: i64 = 0
        var k = ""
        var v = ""
        var in_val: i64 = 0
        while i < n {
            var ch = str_char(p, i)
            if in_val == 0 {
                // 键区：空白与分隔符直接丢弃，冒号进入值区。
                if ch == ":" {
                    in_val = 1
                } else if !is_decl_sep(ch) {
                    k = k + ch
                }
            } else if is_decl_sep(ch) {
                var kk = trim(k)
                if kk != "" {
                    table_push(out, kk)
                    table_push(out, trim(v))
                }
                k = ""
                v = ""
                in_val = 0
            } else {
                v = v + ch
            }
            i = i + 1
        }
        var kk2 = trim(k)
        if kk2 != "" {
            table_push(out, kk2)
            table_push(out, trim(v))
        }
        return out
    }

    // 单元表每帧重建，解析结果必须跟着失效。
    pub func reset() {
        g_parsed = 0
        g_owner = table_new_string()
        g_key = table_new_string()
        g_val = table_new_string()
    }

    // 解析全部 style 单元。返回声明条数。
    pub func parse() -> i64 {
        if g_parsed == 1 {
            return len(g_key)
        }
        reset()
        var n = ui.unit_count()
        var u: i64 = 0
        while u < n {
            if ui.unit_kind_at(u) == "style" {
                var name = ui.unit_name_at(u)
                var parts = decl_parts(ui.unit_payload_at(u))
                var j: i64 = 0
                while j + 1 < len(parts) {
                    table_push(g_owner, name)
                    table_push(g_key, parts[j])
                    table_push(g_val, parts[j + 1])
                    j = j + 2
                }
            }
            u = u + 1
        }
        g_parsed = 1
        return len(g_key)
    }

    // 某个样式是否已声明。
    pub func has(name: string) -> bool {
        if g_parsed == 0 {
            parse()
        }
        var i: i64 = 0
        while i < len(g_key) {
            if g_owner[i] == name {
                return true
            }
            i = i + 1
        }
        return false
    }

    // 某样式声明的键数（供诊断）。
    pub func decl_count(name: string) -> i64 {
        if g_parsed == 0 {
            parse()
        }
        var n: i64 = 0
        var i: i64 = 0
        while i < len(g_key) {
            if g_owner[i] == name {
                n = n + 1
            }
            i = i + 1
        }
        return n
    }

    // 把样式声明摊到所有引用它的节点上；返回实际写入的属性条数。
    // 只写节点尚未声明的键 —— 这就是「内联属性优先」的全部实现。
    pub func apply_all() -> i64 {
        if g_parsed == 0 {
            parse()
        }
        var written: i64 = 0
        var n = ui.count()
        var id: i64 = 0
        while id < n {
            var sname = ui.attr_of(id, "style")
            if sname != "" {
                var i: i64 = 0
                while i < len(g_key) {
                    if g_owner[i] == sname {
                        var key = g_key[i]
                        if ui.attr_of(id, key) == "" {
                            ui.attr_set(id, key, g_val[i])
                            written = written + 1
                        }
                    }
                    i = i + 1
                }
            }
            id = id + 1
        }
        return written
    }
}
