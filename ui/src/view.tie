type tie<class>
// ui/src/view.tie —— tiu 声明式视图层（前端式写法，纯 tie 现有语法）
// EN: tiu declarative view layer — frontend-style authoring in pure tie.
// ============================================================
// 目标：把写 tiu 界面变成写前端组件那样的体验——纯函数、声明式嵌套、
// 组件可复用、条件/列表渲染内联、状态变化自动重渲染。
//
// ---- 单一真源（架构裁定）----
// 本层不再直接向 `tiu_build` 发指令流，而是把 `Elem` 树写进 **std/ui 的中立
// 描述树**，随后交给 `ui_bridge` 做「控件类型 + 类型化属性 → 布局求解」。
// 于是三条入口共用同一条下游管线：
//   元素语法（编译器降解）→ std/ui ─┐
//   本文件（vw 组合子）   → std/ui ─┼→ ui_bridge → tiu 骨架 → layout2 → paint
//   应用代码（直接调 ui）→ std/ui ─┘
// 换言之：`vw` 是同一棵中立树上的语法糖，不是第二条渲染路径。
//
// ---- 设计依据（2026-09-26 实测，非推测）----
//   ✓ 表字面量 `[a, b]` 可嵌套表达子树
//   ✓ enum payload：string / i64 / `table<Elem>` 递归 / 多字段——均可用
//   ✓ 泛型函数 + `fn` 参数（`each<T>(items, f)`）——可用（组件与列表渲染的基石）
//   ✓ `for it in table` 遍历——可用
//   ✗ `if` / `for` 作表达式——不可用（"无法以 If/For 开始表达式"）
//        → 条件渲染由 `show_if` / `hide_if` / `choose` 补足
//        → 列表渲染由 `each_str` / `each_i64` 补足
//   ✗ 表字面量尾随逗号——不支持（"无法以 RBracket 开始表达式"）
//   ✗ `{ }` 在表达式位置是 map 字面量——不能用作 UI 块
//   ✗ `table<Elem>`（struct 行池）不能作函数形参（p.9.12.6 边界）
//        → 故容器构造走 **enum 构造**（`Elem.Row([...])`），不走包装函数；
//          叶构造器（Text/Button）形参仅标量/string，可用函数
//   ✗ enum payload 不支持 struct / fn（E00365）
//        → 控件属性以**扁平标量**表达，而非 props struct（待 p.8.1.8）
//
// ---- 用法（写起来与前端组件一致）----
//
//   func app(s: State) -> Elem {
//       return Elem.Column([
//           Text("tiu demo"),
//           Text("count " + to_string(s.count)),
//           Elem.Row([
//               Button("-1", ACT_DEC),
//               Button("+1", ACT_INC)
//           ]),
//           show_if(s.count > 3, Text("big!"))
//       ])
//   }
//
//   // 单帧：mount_at 会写 std/ui 树并立刻求解布局，返回 tiu 根节点。
//   var root = mount_at(app(s), 360, 260)
//
// 组件 = 普通函数（可带参、可泛型、可组合）；状态由应用层持有；状态变化后
// 重新调用 app(s) 得到新树，框架按 slot 复用骨架（差分 O(变化)，静态帧零重绘）。

import "./tree.tie"
import "./build.tie"
import "./ui_bridge.tie"
import "/std/ui.tie" as ui

// ---- 声明式节点（enum 递归 payload 承载树）----
// 变体语义：
//   Text(s)                     文本
//   Button(label, act)          自适应尺寸按钮
//   ButtonSized(label, act, w, h) 固定尺寸按钮
//   Row(kids) / Column(kids)    容器
//   Spacer(h)                   纵向留白（不产绘制记录）
//   Empty                       空节点（条件渲染的假分支，不产记录）

// 顶层声明默认公有（§7.1），故 enum 不加 `pub`（`pub` 仅用于 func / macro）。
// ⚠ **变体只能在末尾追加**：emit() 按变体序号分派，插在中间会错位。
enum Elem {
    Text(string)
    Button(string, i64)
    ButtonSized(string, i64, i64, i64)
    Row(table<Elem>)
    Column(table<Elem>)
    Spacer(i64)
    Empty
    // ---- p.9.4.2 首批控件补齐（2026-10-03）----
    // 首批控件清单（widgets §模块二）：Button / Text / Row / Column /
    // Scroll / TextInput / Image —— 至此七个齐备。
    Scroll(table<Elem>, i64)     // 内容 + 视口高（滚动偏移由外部 set_scroll 驱动）
    TextInput(string, i64)        // 占位符 + 动作码（文本经 set_text 写入）
    Image(i64, i64, i64)          // 资源句柄 + 宽 + 高（句柄 0 = 占位块）
}

namespace vw {

// ---- 动作码与事件处理器 ----
// 动作码 `act` 是应用层自己定义的状态机编号；本层把它挂到 std/ui 节点上，
// 并在点击时登记为「待取动作」，由应用层用 `take_action()` 取走。
// 这样 vw 视图与元素语法共用同一条事件轴（捕获 → 目标 → 冒泡）。
pub var g_vw_act: table<i64> = []   // std/ui 节点 id → 动作码
pub var g_vw_pending: i64 = 0       // 最近一次点击对应的动作码（0 = 无）

// 事件处理器：签名与 std/ui 的函数值事件表一致。
pub func on_act(id: i64, x: i64, y: i64, kind: string) -> i64 {
    if id < 0 || id >= len(g_vw_act) {
        return 0
    }
    var a = g_vw_act[id]
    if a == 0 {
        return 0
    }
    g_vw_pending = a
    return 1
}

// 取走并清空待处理动作（0 = 没有点击）。
pub func take_action() -> i64 {
    var a = g_vw_pending
    g_vw_pending = 0
    return a
}

// ---- 叶构造器（形参仅标量/string，故可用函数）----

pub func Text(s: string) -> Elem {
    return Elem.Text(s)
}

pub func Button(label: string, act: i64) -> Elem {
    return Elem.Button(label, act)
}

pub func ButtonSized(label: string, act: i64, w: i64, h: i64) -> Elem {
    return Elem.ButtonSized(label, act, w, h)
}

pub func Spacer(h: i64) -> Elem {
    return Elem.Spacer(h)
}

pub func Empty() -> Elem {
    return Elem.Empty
}

// ---- 首批控件补齐的构造器（2026-10-03）----

// 滚动容器：kids 为内容，vh 为视口高（超出部分被裁剪）。
pub func Scroll(kids: table<Elem>, vh: i64) -> Elem {
    return Elem.Scroll(kids, vh)
}

// 文本输入：placeholder 为空文本时的提示，act 为提交/聚焦动作码。
// ⚠ 实参写进变体的是**占位符**；真实文本在重渲染时由 set_text 写入节点。
pub func TextInput(placeholder: string, act: i64) -> Elem {
    return Elem.TextInput(placeholder, act)
}

// 图像：res 为资源句柄（0 = 占位块），w/h 为绘制尺寸。
pub func Image(res: i64, w: i64, h: i64) -> Elem {
    return Elem.Image(res, w, h)
}

// ---- 条件渲染（补足「if 不能作表达式」）----
// 注：函数名不可用 `when`（tie 关键词：switch 守卫条件），故取 `show_if`。
// 严格求值下 e 恒被构造（构造是纯函数、无副作用），cond 为假时返回 Empty
// 不进入树——语义等价前端的条件渲染。

pub func show_if(cond: bool, e: Elem) -> Elem {
    if cond {
        return e
    }
    return Elem.Empty
}

pub func hide_if(cond: bool, e: Elem) -> Elem {
    if cond {
        return Elem.Empty
    }
    return e
}

// 二选一（等价前端的三元 / if-else 表达式）。
pub func choose(cond: bool, a: Elem, b: Elem) -> Elem {
    if cond {
        return a
    }
    return b
}

// ---- 列表渲染（补足「for 不能作表达式」）----
// 返回 `table<Elem>`，直接作为容器实参内联：`Elem.Row(each_str(xs, f))`

pub func each_str(items: table<string>, f: fn(string) -> Elem) -> table<Elem> {
    var out: table<Elem> = []
    for it in items {
        table_push(out, f(it))
    }
    return out
}

pub func each_i64(items: table<i64>, f: fn(i64) -> Elem) -> table<Elem> {
    var out: table<Elem> = []
    for it in items {
        table_push(out, f(it))
    }
    return out
}

// 带索引版本（组件按 item + index 构造）。
pub func each_index_str(items: table<string>, f: fn(string, i64) -> Elem) -> table<Elem> {
    var out: table<Elem> = []
    var i: i64 = 0
    for it in items {
        table_push(out, f(it, i))
        i = i + 1
    }
    return out
}

// ---- 常用组合子 ----

// 过滤（等价前端 filter）。
pub func filter_str(items: table<string>, keep: fn(string) -> bool) -> table<string> {
    var out: table<string> = []
    for it in items {
        if keep(it) {
            table_push(out, it)
        }
    }
    return out
}

// 子表拼接（把多段子树接成一个序列，便于条件/列表混排）。
pub func join(a: table<Elem>, b: table<Elem>) -> table<Elem> {
    var out: table<Elem> = []
    for x in a {
        table_push(out, x)
    }
    for y in b {
        table_push(out, y)
    }
    return out
}

// ---- 树 → std/ui 中立描述树（唯一真源）----
// 返回写入的 ui 节点数。调用方随后用 `mount_at` 一并求解布局。

pub func mount(root: Elem) -> i64 {
    ui.reset()
    g_vw_act = table_new_i64()
    g_vw_pending = 0
    return emit(root, true)
}

// 写树 + 求解布局：返回 tiu 骨架根节点（-1 = 空树）。
// 视口尺寸决定 `fill` 的基准，也决定根节点的铺满范围。
pub func mount_at(root: Elem, w: i64, h: i64) -> i64 {
    ui.reset()
    g_vw_act = table_new_i64()
    g_vw_pending = 0
    emit(root, true)
    return ui_bridge.build_at(w, h)
}

// 记录动作码：写进 g_vw_act（按 std/ui 节点 id 下标），供 on_act 查表。
func mark_act(act: i64) {
    if act == 0 {
        return
    }
    var id = ui.current()
    while len(g_vw_act) <= id {
        table_push(g_vw_act, 0)
    }
    g_vw_act[id] = act
}

// 容器：默认横向铺满（块级语义），根容器再铺满高度。
func emit_box(kind: string, kids: table<Elem>, root: bool) -> i64 {
    ui.begin(kind, "")
    ui.attr_str("w", "fill")
    if root {
        ui.attr_str("h", "fill")
    }
    var n: i64 = 1
    var i: i64 = 0
    while i < len(kids) {
        n = n + emit(kids[i], false)
        i = i + 1
    }
    ui.end()
    return n
}

// 递归发射：把 Elem 树写进 std/ui（不再直接发 tiu_build 指令流）。
func emit(e: Elem, root: bool) -> i64 {
    switch e {
        case Elem.Text(s):
            ui.begin("label", "")
            ui.content(s)
            ui.end()
            return 1
        case Elem.Button(label, act):
            ui.begin("button", "")
            ui.attr_str("text", label)
            ui.attr_str("act", to_string(act))
            mark_act(act)
            ui.on("click", on_act)
            ui.end()
            return 1
        case Elem.ButtonSized(label, act, w, h):
            ui.begin("button", "")
            ui.attr_str("text", label)
            ui.attr_str("w", to_string(w))
            ui.attr_str("h", to_string(h))
            ui.attr_str("act", to_string(act))
            mark_act(act)
            ui.on("click", on_act)
            ui.end()
            return 1
        case Elem.Row(kids):
            return emit_box("row", kids, root)
        case Elem.Column(kids):
            return emit_box("column", kids, root)
        case Elem.Spacer(h):
            if h <= 0 {
                return 0
            }
            ui.begin("row", "")
            ui.attr_str("h", to_string(h))
            ui.end()
            return 1
        case Elem.Empty:
            return 0
        case Elem.Scroll(kids, vh):
            ui.begin("scroll", "")
            ui.attr_str("w", "fill")
            ui.attr_str("h", to_string(vh))
            var n: i64 = 1
            var i: i64 = 0
            while i < len(kids) {
                n = n + emit(kids[i], false)
                i = i + 1
            }
            ui.end()
            return n
        case Elem.TextInput(placeholder, act):
            ui.begin("input", "")
            ui.attr_str("text", placeholder)
            ui.attr_str("act", to_string(act))
            mark_act(act)
            ui.end()
            return 1
        case Elem.Image(res, w, h):
            ui.begin("image", "")
            ui.attr_str("res", to_string(res))
            ui.attr_str("w", to_string(w))
            ui.attr_str("h", to_string(h))
            ui.end()
            return 1
        default:
            return 0
    }
}

}
