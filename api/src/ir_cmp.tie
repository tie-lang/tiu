type tie<class>
// api/src/ir_cmp.tie —— tiu 绘制 API：gold IR 比较器
// ============================================================
// 探针工具线（实施计划 T2.4）：IR 字节流与基准逐字节比较 +
// 首个差异偏移报告。确定性（字节级相等，无浮点）。
//
// EN: gold IR comparator — byte-exact comparison + first-diff offset.

namespace ircmp {

// 逐字节相等。
pub func eq(a: table<i64>, b: table<i64>) -> bool {
    var n = len(a)
    if n != len(b) {
        return false
    }
    var i: i64 = 0
    while i < n {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// 首个差异偏移（-1 = 相等）。
pub func diff_at(a: table<i64>, b: table<i64>) -> i64 {
    var n = len(a)
    var m = len(b)
    var lim = n
    if m < lim {
        lim = m
    }
    var i: i64 = 0
    while i < lim {
        if a[i] != b[i] {
            return i
        }
        i = i + 1
    }
    if n != m {
        return lim
    }
    return -1
}

// 十六进制转储（诊断；每字节 2 位）。
pub func hex(t: table<i64>) -> string {
    var out = ""
    var i: i64 = 0
    while i < len(t) {
        out = out + hex2(t[i])
        i = i + 1
    }
    return out
}

func hex2(v: i64) -> string {
    var b = v & 0xFF
    var hi = b >> 4
    var lo = b & 0x0F
    return dhex(hi) + dhex(lo)
}

func dhex(d: i64) -> string {
    if d < 10 {
        return to_string(d)
    }
    if d == 10 {
        return "a"
    }
    if d == 11 {
        return "b"
    }
    if d == 12 {
        return "c"
    }
    if d == 13 {
        return "d"
    }
    if d == 14 {
        return "e"
    }
    return "f"
}

}
