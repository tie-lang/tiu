type tie<class>
// api/src/path.tie —— tiu 绘制 API 对象模型：Path 记录
import "./tabutil.tie"
// ============================================================
// Path 数据记录 = 命令序列（数据数组），对齐 docs/designs/
// tiu-drawing-api.md §3.3：moveTo / lineTo / quadTo / cubicTo /
// arcTo / close；支持 fill 与 stroke 两种边界语义（由消费方 Paint
// 决定）。值语义、不可变：任何"追加命令"返回**新 Path**（clone 表 +
// push），旧 Path 恒有效（别名安全）。
//
// 存储：双表列式 —— ops: table<i64> 命令码；args: table<f64> 参数
// 连续段。命令码与参数个数（固定推导表）：
//   MOVE=1 (x, y) · LINE=2 (x, y) · QUAD=3 (x1,y1,x2,y2) ·
//   CUBIC=4 (x1,y1,x2,y2,x3,y3) · ARC=5 (x, y, r, a0, a1) ·
//   CLOSE=6 ()
// 第 i 条命令的 args 段偏移 = 前 i 条命令参数个数累计。
//
// EN: Path record = command sequence (data array), immutable —
// appending a command returns a new Path; old Path stays valid.
// Storage: dual tables ops (command codes) + args (flat parameter
// segments); arg counts derived per opcode.

const P_MOVE: i64 = 1
const P_LINE: i64 = 2
const P_QUAD: i64 = 3
const P_CUBIC: i64 = 4
const P_ARC: i64 = 5
const P_CLOSE: i64 = 6

struct Path {
    var ops: table<i64> = table_new_i64()
    var args: table<f64> = table_new_f64()
    var n: i64 = 0
}

namespace path {

// 空 Path。
pub func new() -> Path {
    return Path()
}

// 追加 moveTo(x, y) → 新 Path。
pub func move_to(p: Path, x: f64, y: f64) -> Path {
    var np = Path()
    var ops = tabu.clone_i64(p.ops)
    var args = tabu.clone_f64(p.args)
    np.n = p.n
    table_push(ops, P_MOVE)
    table_push(args, x)
    table_push(args, y)
    np.n = np.n + 1
    np.ops = ops
    np.args = args
    return np
}

// 追加 lineTo(x, y) → 新 Path。
pub func line_to(p: Path, x: f64, y: f64) -> Path {
    var np = Path()
    var ops = tabu.clone_i64(p.ops)
    var args = tabu.clone_f64(p.args)
    np.n = p.n
    table_push(ops, P_LINE)
    table_push(args, x)
    table_push(args, y)
    np.n = np.n + 1
    np.ops = ops
    np.args = args
    return np
}

// 追加 quadTo(x1, y1, x2, y2) → 新 Path。
pub func quad_to(p: Path, x1: f64, y1: f64, x2: f64, y2: f64) -> Path {
    var np = Path()
    var ops = tabu.clone_i64(p.ops)
    var args = tabu.clone_f64(p.args)
    np.n = p.n
    table_push(ops, P_QUAD)
    table_push(args, x1)
    table_push(args, y1)
    table_push(args, x2)
    table_push(args, y2)
    np.n = np.n + 1
    np.ops = ops
    np.args = args
    return np
}

// 追加 cubicTo(x1,y1,x2,y2,x3,y3) → 新 Path。
pub func cubic_to(p: Path, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64) -> Path {
    var np = Path()
    var ops = tabu.clone_i64(p.ops)
    var args = tabu.clone_f64(p.args)
    np.n = p.n
    table_push(ops, P_CUBIC)
    table_push(args, x1)
    table_push(args, y1)
    table_push(args, x2)
    table_push(args, y2)
    table_push(args, x3)
    table_push(args, y3)
    np.n = np.n + 1
    np.ops = ops
    np.args = args
    return np
}

// 追加 arcTo(x, y, r, a0, a1)（a0/a1 弧度）→ 新 Path。
pub func arc_to(p: Path, x: f64, y: f64, r: f64, a0: f64, a1: f64) -> Path {
    var np = Path()
    var ops = tabu.clone_i64(p.ops)
    var args = tabu.clone_f64(p.args)
    np.n = p.n
    table_push(ops, P_ARC)
    table_push(args, x)
    table_push(args, y)
    table_push(args, r)
    table_push(args, a0)
    table_push(args, a1)
    np.n = np.n + 1
    np.ops = ops
    np.args = args
    return np
}

// 追加 close() → 新 Path。
pub func close(p: Path) -> Path {
    var np = Path()
    var ops = tabu.clone_i64(p.ops)
    var args = tabu.clone_f64(p.args)
    np.n = p.n
    table_push(ops, P_CLOSE)
    np.n = np.n + 1
    np.ops = ops
    np.args = args
    return np
}

// 命令数。
pub func cmd_count(p: Path) -> i64 {
    return p.n
}

// 第 i 条命令的命令码。
pub func cmd_op(p: Path, i: i64) -> i64 {
    return p.ops[i]
}

// 第 i 条命令的参数个数。
pub func cmd_argc(op: i64) -> i64 {
    if op == P_MOVE || op == P_LINE {
        return 2
    }
    if op == P_QUAD {
        return 4
    }
    if op == P_CUBIC || op == P_ARC {
        return 6
    }
    return 0   // P_CLOSE
}

// 第 i 条命令的 args 段偏移（前 i 条命令参数累计）。
func arg_offset(p: Path, i: i64) -> i64 {
    var ofs: i64 = 0
    var k: i64 = 0
    while k < i {
        ofs = ofs + cmd_argc(p.ops[k])
        k = k + 1
    }
    return ofs
}

// 第 i 条命令的参数段（复制为新表）。
pub func cmd_args(p: Path, i: i64) -> table<f64> {
    var ofs = arg_offset(p, i)
    var cnt = cmd_argc(p.ops[i])
    var out = table_new_f64()
    var k: i64 = 0
    while k < cnt {
        table_push(out, p.args[ofs + k])
        k = k + 1
    }
    return out
}

// 命令序列文本化（gold 比较 / 诊断用）。形如 "M x y L x y Z"。
pub func dump(p: Path) -> string {
    var out = ""
    var i: i64 = 0
    while i < p.n {
        var op = p.ops[i]
        var a = arg_offset(p, i)
        if op == P_MOVE {
            out = out + "M " + ftos(p.args[a]) + " " + ftos(p.args[a + 1]) + " "
        } else if op == P_LINE {
            out = out + "L " + ftos(p.args[a]) + " " + ftos(p.args[a + 1]) + " "
        } else if op == P_QUAD {
            out = out + "Q " + ftos(p.args[a]) + " " + ftos(p.args[a + 1]) + " " + ftos(p.args[a + 2]) + " " + ftos(p.args[a + 3]) + " "
        } else if op == P_CUBIC {
            out = out + "C " + ftos(p.args[a]) + " " + ftos(p.args[a + 1]) + " " + ftos(p.args[a + 2]) + " " + ftos(p.args[a + 3]) + " " + ftos(p.args[a + 4]) + " " + ftos(p.args[a + 5]) + " "
        } else if op == P_ARC {
            out = out + "A " + ftos(p.args[a]) + " " + ftos(p.args[a + 1]) + " " + ftos(p.args[a + 2]) + " " + ftos(p.args[a + 3]) + " " + ftos(p.args[a + 4]) + " "
        } else {
            out = out + "Z "
        }
        i = i + 1
    }
    return out
}

// 深度相等。
pub func eq(p1: Path, p2: Path) -> bool {
    if p1.n != p2.n {
        return false
    }
    var i: i64 = 0
    while i < p1.n {
        if p1.ops[i] != p2.ops[i] {
            return false
        }
        i = i + 1
    }
    var na = len(p1.args)
    if na != len(p2.args) {
        return false
    }
    var k: i64 = 0
    while k < na {
        if p1.args[k] != p2.args[k] {
            return false
        }
        k = k + 1
    }
    return true
}

// f64 → 字符串（定长 6 位小数，gold 确定性）。
func ftos(v: f64) -> string {
    return to_string(v)
}

}
