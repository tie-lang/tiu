type tie<logic>
import "../src/tabutil.tie"
import "../src/color.tie"
import "../src/paint.tie"

func main() -> i64 {
    var st = paint.stop(255, 0, 0, 255, 0.0)
    st = paint.stop_add(st, 0, 0, 255, 255, 1.0)
    var p_lin = paint.linear(0.0, 0.0, 100.0, 0.0, st)
    println("stops=" + to_string(paint.stop_count(p_lin.stops)) + " q16=" + to_string(p_lin.stops[9]))
    var p2 = paint.with_alpha(p_lin, 64)
    println("alpha " + to_string(p_lin.alpha) + " " + to_string(p2.alpha))
    return 0
}
