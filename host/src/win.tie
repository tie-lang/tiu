type tie<class>
// host/src/win.tie —— tiu host 层 tie 面：Win32 窗口壳绑定（窗口 / 事件 / 上屏）
// EN: tiu host layer, tie side — Win32 window-shell binding (window / events / present).
// ============================================================
// 定位（依据 docs/designs/tiu-render-engine.md §10/§11、tiu-render-impl.md §1 T4.1）：
// tiu 三层（UI / API / engine）之外的最小平台壳的 tie 侧。窗口状态机
// （closed / paint_pending / 后备缓冲留存副本 / 事件环形队列）**全部收敛在
// C 端** host/win32/tiu_host.cpp（纯 Win32 C 入口）。
//
// 为什么 WndProc 必须在 C 端：tie 无法把函数值作为 extern 形参传递
// （2026-09-26 实测 error[E00041]：extern 形参仅接受标量 / string / ptr / slice），
// 故 C 回调不可用、窗口消息循环无法用 tie 写。这是本层存在的唯一根因。
// 演进方向：编译器支持 C 回调后，本 C 壳整体退役、平台层转纯 tie。
//
// 来源与吸收状态：C 壳收编自 ext/gfx/win（p.6.8.9 / p.6.8.10，trm.ui 路线），
// 收编时逐字节核验一致；tie 侧绑定与呈现路径按 tiu 帧缓冲形态重写。
//
// 边界：本模块不感知控件 / 布局 / 绘制语义；只做「开窗 / 泵消息 / 收事件 /
// 把一帧像素送上屏」。像素格式约定 = BGRA 32bpp top-down（win_present 语义）。

// ---- Windows extern（文件顶层；user32 / gdi32 随 toolchain 默认链入）----
unsafe extern fn win_open(p0: ptr<u8>, p1: i32, p2: i32, p3: i32) -> i64
unsafe extern fn win_show(p0: i64)
unsafe extern fn win_update(p0: i64)
unsafe extern fn win_pump(p0: i64) -> i32
unsafe extern fn win_closed(p0: i64) -> i32
unsafe extern fn win_paint_pending(p0: i64) -> i32
unsafe extern fn win_present(p0: i64, p1: ptr<u8>, p2: i32, p3: i32, p4: i32) -> i32
unsafe extern fn win_destroy(p0: i64)
unsafe extern fn win_events_avail(p0: i64) -> i32
unsafe extern fn win_event_pop(p0: i64, p1: ptr<u8>) -> i32
unsafe extern fn win_event_overflow(p0: i64) -> i32
unsafe extern fn Sleep(p0: u32)
unsafe extern fn PostMessageW(p0: i64, p1: u32, p2: i64, p3: i64) -> i64

// ---- 合成注入用消息码（探针确定性驱动事件路径，不依赖真人输入）----
const WM_MOUSEMOVE: i64 = 0x0200
const WM_LBUTTONDOWN: i64 = 0x0201

// ---- 事件类型码（对齐 tiu_host.cpp 的 EVENT_* 定义）----
// 事件记录 = 5 个 i64 槽 [type, x, y, key, t_ms]（C 端 out 参数布局）。
const EV_SLOT: i64 = 5
const EV_MOUSE_MOVE: i64 = 1
const EV_LBUTTON_DOWN: i64 = 2
const EV_LBUTTON_UP: i64 = 3
const EV_RBUTTON_DOWN: i64 = 4
const EV_RBUTTON_UP: i64 = 5
const EV_KEY_DOWN: i64 = 6
const EV_KEY_UP: i64 = 7
const EV_TIMER: i64 = 8

namespace host {

// ---- 事件类型码访问器（跨模块只导出函数，故以函数暴露常量）----
pub func ev_mouse_move() -> i64 { return EV_MOUSE_MOVE }
pub func ev_lbutton_down() -> i64 { return EV_LBUTTON_DOWN }
pub func ev_lbutton_up() -> i64 { return EV_LBUTTON_UP }
pub func ev_rbutton_down() -> i64 { return EV_RBUTTON_DOWN }
pub func ev_rbutton_up() -> i64 { return EV_RBUTTON_UP }
pub func ev_key_down() -> i64 { return EV_KEY_DOWN }
pub func ev_key_up() -> i64 { return EV_KEY_UP }
pub func ev_timer() -> i64 { return EV_TIMER }
pub func ev_slot() -> i64 { return EV_SLOT }

// ---- 标题宽字符桥（UTF-16LE，含代理对拆分）----

// title 的 UTF-16LE 字节数（不含尾 0）。
func wide_byte_len(s: string) -> i64 {
    var n = str_len(s)
    var total: i64 = 0
    var i: i64 = 0
    while i < n {
        var cp = char_code(str_char(s, i))
        total = total + 2
        if cp > 0xFFFF {
            total = total + 2
        }
        i = i + 1
    }
    return total
}

// ---- 窗口生命周期 ----

// 打开窗口（标题经 UTF-16LE 编码传给 C），返回 HWND(i64)；失败 0。
pub func open(title: string, w: i64, h: i64) -> i64 {
    unsafe {
        var n = str_len(title)
        var total = wide_byte_len(title)
        var buf: ptr<u8> = alloc(total + 2)
        var o: i64 = 0
        var i: i64 = 0
        while i < n {
            var cp = char_code(str_char(title, i))
            if cp > 0xFFFF {
                var v = cp - 0x10000
                var hi = 0xD800 + (v >> 10)
                var lo = 0xDC00 + (v & 0x3FF)
                deref_write(ptr_add(buf, o), as_u8(hi & 0xFF))
                deref_write(ptr_add(buf, o + 1), as_u8((hi >> 8) & 0xFF))
                deref_write(ptr_add(buf, o + 2), as_u8(lo & 0xFF))
                deref_write(ptr_add(buf, o + 3), as_u8((lo >> 8) & 0xFF))
                o = o + 4
            } else {
                deref_write(ptr_add(buf, o), as_u8(cp & 0xFF))
                deref_write(ptr_add(buf, o + 1), as_u8((cp >> 8) & 0xFF))
                o = o + 2
            }
            i = i + 1
        }
        deref_write(ptr_add(buf, o), as_u8(0))
        deref_write(ptr_add(buf, o + 1), as_u8(0))
        var hw = win_open(buf, as_i32(total), as_i32(w), as_i32(h))
        free(buf)
        return hw
    }
}

pub func show(hwnd: i64) {
    unsafe { win_show(hwnd) }
}

pub func update(hwnd: i64) {
    unsafe { win_update(hwnd) }
}

// 消息泵单步（非阻塞排空线程消息队列）；返回本轮处理消息数。
pub func pump(hwnd: i64) -> i64 {
    unsafe { return as_i64(win_pump(hwnd)) }
}

// 1 = 窗口已收到 WM_CLOSE / WM_DESTROY。
pub func closed(hwnd: i64) -> bool {
    unsafe { return win_closed(hwnd) != 0 }
}

// 最近一次 pump 是否处理过 WM_PAINT / WM_SIZE（读前由下一轮 pump 清零）。
pub func paint_pending(hwnd: i64) -> bool {
    unsafe { return win_paint_pending(hwnd) != 0 }
}

pub func destroy(hwnd: i64) {
    unsafe { win_destroy(hwnd) }
}

// 兜底延时（消息泵之间，禁忙等）。单位毫秒。
pub func sleep(ms: i64) {
    unsafe { Sleep(as_u32(ms)) }
}

// ---- 呈现 ----

// 把一帧 BGRA 像素（连续缓冲，w*h*4 字节）送上屏并请求重绘。返回 0 成功。
// buf 所有权归调用方（本函数不改动、不释放）。
// 注：形参含 ptr 故为 unsafe（tie 门禁：ptr 只允许出现在 unsafe 路径）。
pub unsafe func present_bytes(hwnd: i64, buf: ptr<u8>, w: i64, h: i64) -> i64 {
    unsafe {
        return as_i64(win_present(hwnd, buf, as_i32(w * 4), as_i32(w), as_i32(h)))
    }
}

// ---- 事件 ----

// 队列剩余事件条数。
pub func events_avail(hwnd: i64) -> i64 {
    unsafe { return as_i64(win_events_avail(hwnd)) }
}

// 队列是否发生过溢出（容量 256 满后丢最旧）。
pub func event_overflow(hwnd: i64) -> bool {
    unsafe { return win_event_overflow(hwnd) != 0 }
}

// 一次取出当前队列全部事件为平面表：每事件 5 槽 [type, x, y, key, t_ms]。
// 调用方以 ev_slot() 为步长访问。
pub func take_events(hwnd: i64) -> table<i64> {
    unsafe {
        var out = table_new_i64()
        var slot: ptr<u8> = alloc(EV_SLOT * 8)
        while win_event_pop(hwnd, slot) == 1 {
            var k: i64 = 0
            while k < EV_SLOT {
                table_push(out, rd_i64(slot, k * 8))
                k = k + 1
            }
        }
        free(slot)
        return out
    }
}

// 平面事件表第 i 条的字段访问器。
pub func ev_type(flat: table<i64>, i: i64) -> i64 { return flat[i * EV_SLOT] }
pub func ev_x(flat: table<i64>, i: i64) -> i64 { return flat[i * EV_SLOT + 1] }
pub func ev_y(flat: table<i64>, i: i64) -> i64 { return flat[i * EV_SLOT + 2] }
pub func ev_key(flat: table<i64>, i: i64) -> i64 { return flat[i * EV_SLOT + 3] }
pub func ev_ts(flat: table<i64>, i: i64) -> i64 { return flat[i * EV_SLOT + 4] }
pub func ev_count(flat: table<i64>) -> i64 { return len(flat) / EV_SLOT }

// 缓冲小端 i64 读（C 端 long long 槽回读）。形参含 ptr → unsafe。
unsafe func rd_i64(p: ptr<u8>, off: i64) -> i64 {
    var v: i64 = 0
    var k: i64 = 0
    while k < 8 {
        v = v | (as_i64(deref(ptr_add(p, off + k))) << (8 * k))
        k = k + 1
    }
    return v
}

// ---- 合成注入（PostMessageW 直绑）----
// 用途：探针以确定性方式驱动事件路径（不经真人输入），验证 WndProc 捕获 →
// 事件队列 → tie 侧取出 的整条链路。生产路径不由本组函数驱动。

// 客户区坐标 → lParam 打包（LOWORD = x，HIWORD = y）。
func xy_lparam(x: i64, y: i64) -> i64 {
    return ((y & 0xFFFF) << 16) | (x & 0xFFFF)
}

pub func post(hwnd: i64, msg: i64, wparam: i64, lparam: i64) -> bool {
    unsafe { return PostMessageW(hwnd, as_u32(msg), wparam, lparam) != 0 }
}

pub func post_mouse(hwnd: i64, x: i64, y: i64) -> bool {
    return post(hwnd, WM_MOUSEMOVE, 0, xy_lparam(x, y))
}

pub func post_lbutton_down(hwnd: i64, x: i64, y: i64) -> bool {
    return post(hwnd, WM_LBUTTONDOWN, 1, xy_lparam(x, y))
}

}
