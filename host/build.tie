type tie<logic>
// host/build.tie —— tiu host 层构建驱动（tie 写；在 tiu 仓根运行）
// EN: tiu host-layer build driver (tie-written; run from the tiu repo root).
// ============================================================
// 链路（沿用 ext/gfx p.6.8.9-6.8.12 已验证的构建范式）：
//   1) clang-cl /MT 编 host/win32/tiu_host.cpp → tiu_host.obj（Win32 平台壳）
//   2) tiec 编 tests/probe_host.tie --emit-ir → probe_host.ll
//   3) clang -c 编 .ll → probe_host.obj
//   4) clang -fuse-ld=link 链接 probe_host.obj + tiu_host.obj + trm_lite.a
//      + 系统库（user32 / gdi32 / shell32）+ compiler-rt → probe_host.exe
//   5) 运行探针（开窗约 2 秒供人工复核）
//
// 依赖：tiec（兄弟目录 ../tiec/compiler/tiec.exe）
//       · clang / clang-cl（PATH，本机 D:\LLVM\bin）
//       · ../trm-lite/trm_lite.a（tie 表运行时：table<T> 容器符号）
//
// 用法：tiec host\build.tie -o build\host_build.exe && build\host_build.exe

unsafe extern fn system(p0: string) -> i32

var g_out: string = "build\\host"
var g_tiec: string = "..\\tiec\\compiler\\tiec.exe"
var g_host_cpp: string = "host\\win32\\tiu_host.cpp"
var g_host_obj: string = "build\\host\\tiu_host.obj"

func sh(cmd: string) -> i64 {
    println("  $ " + cmd)
    unsafe {
        return as_i64(system(cmd))
    }
}

func die(m: string) -> i64 {
    println("[build] ERROR: " + m)
    exit(1)
    return 1
}

func main() -> i64 {
    if sh("if not exist " + g_out + " mkdir " + g_out) != 0 {
        return die("mkdir " + g_out + " failed")
    }

    // 1) 平台壳（C）—— 两个探针共用
    if sh("clang-cl /MT /O2 /c " + g_host_cpp + " /Fo:" + g_host_obj) != 0 {
        return die("tiu_host.cpp compile failed")
    }
    println("[build] tiu_host.obj ok")

    // 2) 探针逐个：IR → obj → 链接 → 运行
    var names: table<string> = []
    table_push(names, "probe_host")
    table_push(names, "probe_app")
    var i: i64 = 0
    while i < len(names) {
        if build_run(names[i]) != 0 {
            return 1
        }
        i = i + 1
    }

    println("[build] ALL PROBES run ok")
    return 0
}

// 单探针链路：tiec --emit-ir → clang -c → clang 链接 → 运行
func build_run(name: string) -> i64 {
    var src = "tests\\" + name + ".tie"
    var ll = g_out + "\\" + name + ".ll"
    var obj = g_out + "\\" + name + ".obj"
    var exe = g_out + "\\" + name + ".exe"

    if sh(g_tiec + " " + src + " --emit-ir -o " + ll) != 0 {
        return die(name + ": IR failed (tiec)")
    }
    if sh("clang -O2 -c " + ll + " -o " + obj) != 0 {
        return die(name + ": obj failed (clang)")
    }
    var lcmd = "clang -fuse-ld=link " + obj + " " + g_host_obj + " ..\\trm-lite\\trm_lite.a" +
        " -o " + exe +
        " -luser32 -lgdi32 -lshell32 -lole32 -ladvapi32 -rtlib=compiler-rt"
    if sh(lcmd) != 0 {
        return die(name + ": link failed")
    }
    println("[build] " + name + ".exe linked")

    println("[build] running " + name + ".exe (a window appears ~2s) ...")
    var rc = sh(exe)
    if rc != 0 {
        return die(name + " run failed rc=" + to_string(rc))
    }
    println("[build] " + name + " run ok (rc=0)")
    return 0
}
