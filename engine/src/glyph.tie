type tie<class>
// engine/src/glyph.tie —— tiu 渲染引擎：5×7 位图字形（文本起步）
// ============================================================
// 位图字形起步（渲染引擎实施计划 T1.2）：ASCII 可打印子集（大写/
// 小写/数字/常用标点/空格），每字符 7 行 × 5 列，字形数据以
// 可读字符串编码（"01110…" 每行 5 字符，共 35 字符）。字形数据
// 为**输入数据**（非渲染语义）；文本 GPU 化（矢量轮廓）为模块五。
//
// 行值约定：每行 5 bitmask，bit0 = 最左列（列 j → bit j）。
// EN: 5×7 bitmap glyphs (text start): glyph rows encoded as readable
// 35-char strings; bit0 = leftmost column.

const GLYPH_W: i64 = 5
const GLYPH_H: i64 = 7
const GLYPH_ADV: i64 = 6    // 字距（含 1 空列）

namespace eglyph {

// 字符是否有字形（子集 32..126）。
pub func has(c: i64) -> bool {
    if c >= 65 && c <= 90 {
        return true
    }
    if c >= 97 && c <= 122 {
        return true
    }
    if c >= 48 && c <= 57 {
        return true
    }
    if c == 32 || c == 33 || c == 63 || c == 46 || c == 44 || c == 45 || c == 58 ||
       c == 59 || c == 47 || c == 43 || c == 61 || c == 40 || c == 41 || c == 95 ||
       c == 39 || c == 34 {
        return true
    }
    return false
}

// 字符 → 7 行 bitmask（bit0 = 最左列）。
pub func rows(c: i64) -> table<i64> {
    var s = glyph_data(c)
    var t = table_new_i64()
    var i: i64 = 0
    while i < GLYPH_H {
        var row: i64 = 0
        var j: i64 = 0
        while j < GLYPH_W {
            if str_char(s, i * GLYPH_W + j) == "1" {
                row = row | (1 << j)
            }
            j = j + 1
        }
        table_push(t, row)
        i = i + 1
    }
    return t
}

// 字形数据：每字符 35 字符（7 行 × 5 列，"1"= 实心）。
func glyph_data(c: i64) -> string {
    if c == 32 { return "0000000000000000000000000000000000000"
    } else if c == 33 { return "0010000100001000010000100000000001000"
    } else if c == 34 { return "0101001010001010000000000000000000000"
    } else if c == 39 { return "0010000100001000000000000000000000000"
    } else if c == 40 { return "0001000100010001000010000100000100"
    } else if c == 41 { return "0100000100001000100001000010000100"
    } else if c == 43 { return "0000000100001001111100100001000000"
    } else if c == 44 { return "0000000000000000000000110000100010"
    } else if c == 45 { return "0000000000000001111100000000000000"
    } else if c == 46 { return "0000000000000000000000000001100011"
    } else if c == 47 { return "0000100010000100010001000100010000"
    } else if c == 48 { return "0111010001100011000110101110011000101110"
    } else if c == 49 { return "001000110000100001000010000100001110"
    } else if c == 50 { return "011101000100001000100010001000011111"
    } else if c == 51 { return "011101000100001001100000011000101110"
    } else if c == 52 { return "0001000110001010100101111100010000100"
    } else if c == 53 { return "11111100001111000001000011000101110"
    } else if c == 54 { return "00110010001000011110100011000101110"
    } else if c == 55 { return "1111100001000100010001000100001000"
    } else if c == 56 { return "01110100011000101110100011000101110"
    } else if c == 57 { return "01110100011000101111000010001001100"
    } else if c == 58 { return "0000000011000110000000000110001100000"
    } else if c == 59 { return "0000000011000110000000000110000100010"
    } else if c == 61 { return "0000000000001111100000000111110000000"
    } else if c == 63 { return "0111010001000010001000100000000001000"
    } else if c == 65 { return "01110100011000111111100011000110001"
    } else if c == 66 { return "11110100011000111110100011000111110"
    } else if c == 67 { return "01110100011000010000100001000101110"
    } else if c == 68 { return "11110100011000110001100011000111110"
    } else if c == 69 { return "11111100001000011110100001000011111"
    } else if c == 70 { return "11111100001000011110100001000010000"
    } else if c == 71 { return "01110100011000010111100011000101111"
    } else if c == 72 { return "10001100011000111111100011000110001"
    } else if c == 73 { return "01110001000010000100001000010001110"
    } else if c == 74 { return "00111000100001000010000100100101100"
    } else if c == 75 { return "10001100101010011000101001001010001"
    } else if c == 76 { return "10000100001000010000100001000011111"
    } else if c == 77 { return "10001110111010110101100011000110001"
    } else if c == 78 { return "10001100011100110101100111000110001"
    } else if c == 79 { return "01110100011000110001100011000101110"
    } else if c == 80 { return "11110100011000111110100001000010000"
    } else if c == 81 { return "01110100011000110001101011001001101"
    } else if c == 82 { return "11110100011000111110101001001010001"
    } else if c == 83 { return "01111100001000001110000010000111110"
    } else if c == 84 { return "11111001000010000100001000010000100"
    } else if c == 85 { return "10001100011000110001100011000101110"
    } else if c == 86 { return "10001100011000110001100010101000100"
    } else if c == 87 { return "10001100011000110101101011010101010"
    } else if c == 88 { return "10001100010101000100010101000110001"
    } else if c == 89 { return "10001100010101000100001000010000100"
    } else if c == 90 { return "11111000010001000100010001000011111"
    } else if c == 95 { return "0000000000000000000000000000000000000"
    } else if c == 97 { return "00000011101000101111100011000101111"
    } else if c == 98 { return "10000100001111010001100011000111110"
    } else if c == 99 { return "00000011101000110000100001000101110"
    } else if c == 100 { return "0000100001011110001100011000101111"
    } else if c == 101 { return "00000011101000111111100001000101110"
    } else if c == 102 { return "00110010001111101000010000100001000"
    } else if c == 103 { return "01111100011000101111000011000101110"
    } else if c == 104 { return "10000100001111010001100011000110001"
    } else if c == 105 { return "00100000000111000100001000010001110"
    } else if c == 106 { return "00010000000001000010000100100101100"
    } else if c == 107 { return "10000100001001010100110001010010010"
    } else if c == 108 { return "00100001000010000100001000010001110"
    } else if c == 109 { return "00000110111010110101101011010110101"
    } else if c == 110 { return "00000111101000110001100011000110001"
    } else if c == 111 { return "00000011101000110001100011000101110"
    } else if c == 112 { return "11110100011000111110100001000010000"
    } else if c == 113 { return "011111000110001011110000100000100001"
    } else if c == 114 { return "00000111101000110000100001000010000"
    } else if c == 115 { return "00000011101000001110000011000101110"
    } else if c == 116 { return "01000111110100001000010000100000111"
    } else if c == 117 { return "00000100011000110001100011000101111"
    } else if c == 118 { return "00000100011000110001100010101000100"
    } else if c == 119 { return "00000100011000110101101011010101010"
    } else if c == 120 { return "00000100010101000100010101000110001"
    } else if c == 121 { return "10001100011000101111000011000101110"
    } else if c == 122 { return "00000111110001000100010001000011111"
    }
    return "01110100011000111111100011000110001"   // 兜底：A
}

}
