type tie<class>
// engine/src/rrasc.tie —— 圆角矩形覆盖率（软件光栅抗锯齿内核）
// EN: rounded-rect coverage kernel (software anti-aliasing).
// ============================================================
// 职责单一：只回答「设备像素 (x,y) 落在圆角矩形内的覆盖率是多少（0..255）」，
// 供 raster.tie 的 rrect 路径调用。几何入参一律是**设备像素坐标**
// （调用方已完成逻辑 → 设备换算与 DPI 缩放）。
//
// 方法：4×4 超采样（每轴样本取 (i*2+1)/8，即 1/8、3/8、5/8、7/8）。
//   * 直边：同一像素内 16 个样本同进同出 ⇒ 覆盖率恒 0 或 255（硬边）；
//   * 圆角：样本按象限圆判定逐点落入 ⇒ 覆盖率取 17 级之一（灰阶过渡）。
// 圆判定用 dx²+dy² ≤ r²，不引入 sqrt / 距离场，避免浮点开方依赖。
//
// 简化项：椭圆角（rx ≠ ry）未支持——属性层只有单一 radius，取 min(rx, ry)。

namespace rrasc {

pub const SS: i64 = 4     // 每轴样本数
pub const SS_N: i64 = 16  // 每像素样本数（= SS * SS；常量初始化不支持引用常量，直接写 16）

// 点是否在圆角矩形内（1 = 内，0 = 外）。
// 四角各取象限圆心 (x0+r,y0+r)、(x1-r,y0+r)、(x0+r,y1-r)、(x1-r,y1-r)。
pub func inside(px: f64, py: f64, x0: f64, y0: f64, x1: f64, y1: f64, r: f64) -> i64 {
    if px < x0 || px > x1 || py < y0 || py > y1 {
        return 0
    }
    var rr = r
    var hw = (x1 - x0) * 0.5
    var hh = (y1 - y0) * 0.5
    if rr > hw {
        rr = hw
    }
    if rr > hh {
        rr = hh
    }
    if rr <= 0.0 {
        return 1
    }
    var cx = 0.0
    var cy = 0.0
    var corner: i64 = 0
    if px < x0 + rr && py < y0 + rr {
        cx = x0 + rr
        cy = y0 + rr
        corner = 1
    } else if px > x1 - rr && py < y0 + rr {
        cx = x1 - rr
        cy = y0 + rr
        corner = 1
    } else if px < x0 + rr && py > y1 - rr {
        cx = x0 + rr
        cy = y1 - rr
        corner = 1
    } else if px > x1 - rr && py > y1 - rr {
        cx = x1 - rr
        cy = y1 - rr
        corner = 1
    }
    if corner == 0 {
        return 1
    }
    var dx = px - cx
    var dy = py - cy
    if dx * dx + dy * dy <= rr * rr {
        return 1
    }
    return 0
}

// 像素覆盖率（0..255）：16 个样本计数 → 255 分度四舍五入。
pub func cov_px(x: i64, y: i64, x0: f64, y0: f64, x1: f64, y1: f64, r: f64) -> i64 {
    var hit: i64 = 0
    var j: i64 = 0
    while j < SS {
        var py = to_f64(y) + to_f64(j * 2 + 1) / (to_f64(SS) * 2.0)
        var i: i64 = 0
        while i < SS {
            var px = to_f64(x) + to_f64(i * 2 + 1) / (to_f64(SS) * 2.0)
            hit = hit + inside(px, py, x0, y0, x1, y1, r)
            i = i + 1
        }
        j = j + 1
    }
    return (hit * 255 + SS_N / 2) / SS_N
}

// 该像素是否落在「圆角带」内（横向圆角带 ∩ 纵向圆角带）。
// raster 用它决定走覆盖率路径还是直接整像素写入——直边区域保持硬边且省算。
pub func in_corner_band(x: i64, y: i64, x0: f64, y0: f64, x1: f64, y1: f64, r: f64) -> i64 {
    var px = to_f64(x) + 0.5
    var py = to_f64(y) + 0.5
    var bx: i64 = 0
    if px < x0 + r || px > x1 - r {
        bx = 1
    }
    var by: i64 = 0
    if py < y0 + r || py > y1 - r {
        by = 1
    }
    if bx == 1 && by == 1 {
        return 1
    }
    return 0
}

}
